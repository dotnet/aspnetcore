<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnablePublicApiAnalyzer>false</EnablePublicApiAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="InspectManagedAssembly.cs" />
    <PackageReference Include="NodaTime" Version="3.3.1" />
    <Reference Include="Corvus.Text.Json"
      HintPath="$(CorvusJsonSchemaSourceRoot)/src/Corvus.Text.Json/bin/Release/net10.0/Corvus.Text.Json.dll"
      Private="true" />
    <Compile Include="../generated/FlagshipCorvusProgramImage.g.cs" Link="Generated/FlagshipCorvusProgramImage.g.cs" />
  </ItemGroup>
</Project>
