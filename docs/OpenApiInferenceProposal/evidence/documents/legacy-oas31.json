          },
          "scopeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "isIPv6Multicast": {
            "type": "boolean"
          },
          "isIPv6LinkLocal": {
            "type": "boolean"
          },
          "isIPv6SiteLocal": {
            "type": "boolean"
          },
          "isIPv6Teredo": {
            "type": "boolean"
          },
          "isIPv6UniqueLocal": {
            "type": "boolean"
          },
          "isIPv4MappedToIPv6": {
            "type": "boolean"
