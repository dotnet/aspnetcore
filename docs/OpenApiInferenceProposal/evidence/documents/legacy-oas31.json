            "type": "string"
          },
          "outputOnly": {
            "type": "string"
          },
          "inputOnly": {
            "type": [
              "null",
              "string"
            ]
          },
          "nullableInput": {
            "type": [
              "null",
              "string"
            ]
          },
          "requiredButOmittable": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "IPAddress": {
