<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Use SDK bundled version to avoid needing workarounds set up here. -->
    <TargetFramework>$(BundledNETCoreAppTargetFramework)</TargetFramework>
    <ExcludeFromSourceOnlyBuild>false</ExcludeFromSourceOnlyBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.Build.Tasks.Templating" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(DotNetBuildSourceOnly)' != 'true' AND '$(DotNetBuildFromVMR)' != 'true'">
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.browser-wasm" Version="[$(MicrosoftNETCoreAppRefVersion)]" />
  </ItemGroup>

  <PropertyGroup>
    <_RuntimeJavaScriptDefinitionsSource Condition="'$(DotNetBuildFromVMR)' == 'true'">$([MSBuild]::NormalizePath('$(SourceBuiltArtifactsBasePath)', 'src/runtime/src/native/libs/Common/JavaScript/loader/dotnet.d.ts'))</_RuntimeJavaScriptDefinitionsSource>
    <_RuntimeJavaScriptDefinitionsSource Condition="'$(DotNetBuildFromVMR)' != 'true'">$(NuGetPackageRoot)microsoft.netcore.app.runtime.browser-wasm/$(MicrosoftNETCoreAppRefVersion)/runtimes/browser-wasm/native/dotnet.d.ts</_RuntimeJavaScriptDefinitionsSource>
    <_RuntimeJavaScriptDefinitionsSourceFile>$(RepoRoot)artifacts/obj/GenerateFiles/runtime-js-definitions.source</_RuntimeJavaScriptDefinitionsSourceFile>
  </PropertyGroup>

  <!-- Track source selection across build modes, which share the same npm input. -->
  <Target Name="PrepareRuntimeJavaScriptDefinitions"
      Condition="'$(DotNetBuildSourceOnly)' != 'true' AND '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(DotNetBuildFromVMR)' == 'true' AND '$(SourceBuiltArtifactsBasePath)' == ''"
      Text="SourceBuiltArtifactsBasePath must be set when copying runtime JavaScript declarations from the VMR." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_RuntimeJavaScriptDefinitionsSourceFile)'))" />
    <WriteLinesToFile File="$(_RuntimeJavaScriptDefinitionsSourceFile)"
      Lines="$(_RuntimeJavaScriptDefinitionsSource)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="CopyRuntimeJavaScriptDefinitions"
      AfterTargets="Restore"
      DependsOnTargets="PrepareRuntimeJavaScriptDefinitions"
      Condition="'$(DotNetBuildSourceOnly)' != 'true' AND '$(DesignTimeBuild)' != 'true'"
      Inputs="$(MSBuildProjectFullPath);$(ProjectAssetsFile);$(_RuntimeJavaScriptDefinitionsSource);$(_RuntimeJavaScriptDefinitionsSourceFile)"
      Outputs="$(RepoRoot)src/Components/dotnet-runtime-js/dotnet.d.ts">
    <Copy
      SourceFiles="$(_RuntimeJavaScriptDefinitionsSource)"
      DestinationFiles="$(RepoRoot)src/Components/dotnet-runtime-js/dotnet.d.ts"
      SkipUnchangedFiles="true" />
    <!-- A different runtime pack can contain an older file; still invalidate the npm build. -->
    <Touch Files="$(RepoRoot)src/Components/dotnet-runtime-js/dotnet.d.ts" />
  </Target>

  <!-- Update artifacts/bin/GenerateFiles/Directory.Build.* files. -->
  <Target Name="GenerateDirectoryBuildFiles">
    <PropertyGroup>
      <_TemplateProperties>
        AspNetCorePatchVersion=$(AspNetCorePatchVersion);
        DefaultNetCoreTargetFramework=$(DefaultNetCoreTargetFramework);
        MicrosoftAspNetCoreAppRefVersion=$(TargetingPackVersion);
        MicrosoftAspNetCoreAppRuntimeVersion=$(SharedFxVersion);
        MicrosoftNETCoreAppRefVersion=$(MicrosoftNETCoreAppRefVersion);
        LibNetHostAppPackVersion=$(BundledNETCoreAppPackageVersion);
        SupportedRuntimeIdentifiers=$([MSBuild]::Escape($(SupportedRuntimeIdentifiers)));
        ArtifactsShippingPackagesDir=$(ArtifactsShippingPackagesDir)
      </_TemplateProperties>
    </PropertyGroup>

    <MakeDir Directories="$(BaseOutputPath)" />

    <Message Importance="High" Text="$(MSBuildProjectName) -&gt; $(BaseOutputPath)Directory.Build.props" />
    <GenerateFileFromTemplate TemplateFile="$(MSBuildThisFileDirectory)Directory.Build.props.in"
      Properties="$(_TemplateProperties)"
      SkipUnchanged="true"
      OutputPath="$(BaseOutputPath)Directory.Build.props" />

    <Message Importance="High" Text="$(MSBuildProjectName) -&gt; $(BaseOutputPath)Directory.Build.targets" />
    <GenerateFileFromTemplate TemplateFile="$(MSBuildThisFileDirectory)Directory.Build.targets.in"
      Properties="$(_TemplateProperties)"
      SkipUnchanged="true"
      OutputPath="$(BaseOutputPath)Directory.Build.targets" />
  </Target>
</Project>
