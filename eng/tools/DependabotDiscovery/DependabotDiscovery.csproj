  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <!-- Microsoft.Owin.* only ship a net45 asset; the default TFM above can't restore them. -->
    <PackageReference Include="Microsoft.Owin.Security.Cookies" />
    <PackageReference Include="Microsoft.Owin.Testing" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' != 'net472' ">
    <!-- These packages only support netcoreapp TFMs; net472 above can't restore them. -->
    <PackageReference Include="AGUI.Abstractions" />
    <PackageReference Include="AGUI.Client" />
    <PackageReference Include="AGUI.Formatting" />
    <PackageReference Include="AGUI.Server" />
    <PackageReference Include="Grpc.AspNetCore" />
