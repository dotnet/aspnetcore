    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Auth" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="MessagePackAnalyzer" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" />
    <PackageReference Include="Microsoft.AspNetCore.AzureAppServices.SiteExtension.10.0.x64" />
    <PackageReference Include="Microsoft.AspNetCore.AzureAppServices.SiteExtension.10.0.x86" />
    <PackageReference Include="Microsoft.AspNetCore.AzureAppServices.SiteExtension.8.0.x64" />
    <PackageReference Include="Microsoft.AspNetCore.AzureAppServices.SiteExtension.8.0.x86" />
    <PackageReference Include="Microsoft.AspNetCore.AzureAppServices.SiteExtension.9.0.x64" />
    <PackageReference Include="Microsoft.AspNetCore.AzureAppServices.SiteExtension.9.0.x86" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.Extensions" />
    <PackageReference Include="Microsoft.AspNetCore.Razor.Language" />
    <PackageReference Include="Microsoft.Azure.SignalR" />
    <PackageReference Include="Microsoft.Bcl.HashCode" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.Razor" />
    <PackageReference Include="Microsoft.CSharp" />
    <PackageReference Include="Microsoft.Css.Parser" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="Microsoft.Extensions.DiagnosticAdapter" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Internal.AspNetCore.H2Spec.All" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.Playwright.TestAdapter" />
