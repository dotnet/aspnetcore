#!/usr/bin/env python3
"""Offline transport for the historical guide failure; never contacts GitHub."""

import json
from pathlib import Path
import sys

arguments = sys.argv[1:]
with Path(__file__).with_name("requests.jsonl").open("a", encoding="utf-8") as log:
    log.write(json.dumps(arguments) + "\n")

base = "13909f3b7ddbfeab04aac1c290f8abf4b75fe42c"
paths = (
    "docs/CrossCuttingGuidance.md",
    "docs/BlazorComponentsGuidance.md",
)
if "api" in arguments and any(
    f"repos/dotnet/aspnetcore/contents/{path}?ref={base}" in arguments
    for path in paths
):
    print('{"message":"Not Found","status":"404"}')
    print("gh: Not Found (HTTP 404)", file=sys.stderr)
    raise SystemExit(1)

print("Offline fixture has no response for this request; no network access was attempted.", file=sys.stderr)
raise SystemExit(64)
