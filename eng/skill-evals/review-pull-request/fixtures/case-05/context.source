=== head 0317f5f729136a3a4f7320ab8bff3aa7d66fe5d6 src/Components/test/testassets/TestContentPackage/InteractiveNavigationComponent.razor:1-41 ===
@inject NavigationManager Navigation

<p id="navigation-runtime">@RendererInfo.Name</p>
<a id="navigate-with-href" href="nav/other" @onclick="NavigateToAnotherPage">Navigate with an unprevented link</a>
<a id="navigate-with-prevented-href" href="nav/other" @onclick="NavigateToAnotherPage" @onclick:preventDefault>Navigate with a prevented link</a>
<button type="button" id="navigate-to-another-page" @onclick="NavigateToAnotherPage">Navigate to another page</button>
<br />
<button type="button" id="refresh-with-navigate-to" @onclick="RefreshWithNavigateTo">Perform enhanced refresh with @(nameof(NavigationManager.NavigateTo))</button>
<br />
<button type="button" id="reload-with-navigate-to" @onclick="ReloadWithNavigateTo">Perform page reload with @(nameof(NavigationManager.NavigateTo))</button>
<br />
<button type="button" id="refresh-with-refresh" @onclick="RefreshWithRefresh">Perform enhanced page refresh with @(nameof(NavigationManager.Refresh))</button>
<br />
<button type="button" id="reload-with-refresh" @onclick="ReloadWithRefresh">Perform page reload with @(nameof(NavigationManager.Refresh))</button>

@code {
    private void NavigateToAnotherPage()
    {
        Navigation.NavigateTo("nav");
    }

    private void RefreshWithNavigateTo()
    {
        Navigation.NavigateTo(Navigation.Uri, replace: true);
    }

    private void ReloadWithNavigateTo()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true, replace: true);
    }

    private void RefreshWithRefresh()
    {
        Navigation.Refresh();
    }

    private void ReloadWithRefresh()
    {
        Navigation.Refresh(forceReload: true);
    }
}

=== head 0317f5f729136a3a4f7320ab8bff3aa7d66fe5d6 src/Components/Web.JS/src/Rendering/Events/EventDelegatorListeners.ts:1-33 ===
// Licensed to the .NET Foundation under one or more agreements.
// The .NET Foundation licenses this file to you under the MIT license.

let clickListenerRegisteredCallback: ((isDispatchingClick: boolean) => void) | undefined;
let clickDispatchDepth = 0;

export function setClickListenerRegisteredCallback(callback: typeof clickListenerRegisteredCallback): void {
  clickListenerRegisteredCallback = callback;
}

export function isDispatchingClick(): boolean {
  return clickDispatchDepth > 0;
}

export function notifyGlobalListenerAdded(eventName: string): void {
  if (eventName === 'click') {
    clickListenerRegisteredCallback?.(clickDispatchDepth > 0);
  }
}

export function dispatchGlobalEvent(event: Event, listener: EventListener): void {
  if (event.type !== 'click') {
    listener(event);
    return;
  }

  clickDispatchDepth++;
  try {
    listener(event);
  } finally {
    clickDispatchDepth--;
  }
}


=== Existing feedback discussion_r4487936812 at commit 0317f5f729136a3a4f7320ab8bff3aa7d66fe5d6 ===
**[P2] [QUESTION] Confirm whether `<a href>` with `@onclick` calling `NavigateTo` (without `@onclick:preventDefault`) should differ between Interactive WebAssembly and Interactive Server**

Because `onDocumentClick` is now moved after the renderer's click delegate, consider a link such as `<a href="/other" @onclick='() => Nav.NavigateTo("/counter")'>` (without `@onclick:preventDefault`) on a page where enhanced navigation is active:
- **Before this PR:** `onDocumentClick` ran first (`/other`), and then the `@onclick` handler's `Nav.NavigateTo("/counter")` ran second and won in both Interactive WebAssembly and Interactive Server (landing on `/counter`).
- **With this PR:** In Interactive WebAssembly, `@onclick` runs synchronously during the click event and starts programmatic enhanced navigation to `/counter`, and then `onDocumentClick` runs second on the un-prevented `<a href="/other">`, aborting `/counter` (`NavigationEnhancement.ts:226`) and landing on `/other` (matching native browser order where an un-prevented link's default action runs after click handlers). However, in Interactive Server, `@onclick` runs asynchronously over SignalR after `onDocumentClick`, so `/counter` still wins.

Is this Interactive WebAssembly (`/other`) vs. Interactive Server (`/counter`) difference intended when `@onclick` calls `NavigateTo` without `@onclick:preventDefault` (for example under `InteractiveAuto`), or should programmatic enhanced navigation initiated during the click take precedence?
