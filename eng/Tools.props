<Project>
  <!-- Update the generated files when we restore projects. -->
  <Target Name="GenerateDirectoryBuildFiles"
      AfterTargets="Restore">
    <!--
      This target runs while a restore is in progress, so MSBuild sets the MSBuildIsRestoring global
      property. Microsoft.Common.props turns that into ImportProjectExtensionProps=false, which skips
      importing obj\GenerateFiles.csproj.nuget.g.props. Dropping MSBuildIsRestoring from the second
      invocation lets it import those package props and resolve the GenerateFileFromTemplate task.
      It also gives the two invocations distinct global property sets, so the second one re-evaluates
      the project instead of reusing the instance restored by the first.
    -->
    <MSBuild Projects="$(RepoRoot)eng\tools\GenerateFiles\GenerateFiles.csproj"
        Targets="Restore" />
    <MSBuild Projects="$(RepoRoot)eng\tools\GenerateFiles\GenerateFiles.csproj"
        RemoveProperties="MSBuildIsRestoring"
        Targets="GenerateDirectoryBuildFiles" />
  </Target>
</Project>
