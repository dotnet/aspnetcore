<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Components.AI consumes Microsoft.Extensions.AI and, in its dojo test assets, the AG-UI
    protocol packages. Neither is mirrored to the dnceng feeds listed in the repository-level
    NuGet.config yet, so restore for this subtree also reads nuget.org. Remove this file once
    those packages are available from the shared feeds.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
