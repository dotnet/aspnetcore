@using Microsoft.AspNetCore.Components.AI

<div class="claim-action-block" role="status" aria-live="polite">
    <span class="claim-action-block__check" aria-hidden="true">✓</span>
    <span>@(Block.IsComplete ? "Vehicle diagram updated" : "Updating vehicle diagram")</span>
</div>

@code {
    private bool _invoking;

    [Parameter, EditorRequired]
    public UIActionBlock Block { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (Block.IsComplete || _invoking)
        {
            return;
        }

        _invoking = true;
        await Block.InvokeAsync();
        _invoking = false;
    }
}
