@inject IChatClient ChatClient
@implements IDisposable

<div class="dojo-scenario human-in-the-loop" data-dojo-scenario="human-in-the-loop">
    <AgentBoundary Agent="_agent">
        <div class="sc-ai-root dojo-chat-panel">
            <MessageList>
                <DojoWelcome />
                <ComponentBlockRenderer TBlock="UIActionBlock"
                                        TRenderer="TaskStepList"
                                        When="@(b => b.ToolName == "generate_task_steps")" />
            </MessageList>
            <SuggestionList Suggestions="_suggestions" />
            <MessageInput Placeholder="Type a message..." />
        </div>
    </AgentBoundary>
</div>

@code {
    private UIAgent _agent = default!;

    private static readonly Suggestion[] _suggestions =
    [
        new() { Label = "Simple plan", Prompt = "Please plan a trip to mars in 5 steps." },
        new() { Label = "Complex plan", Prompt = "Please plan a pasta dish in 10 steps." },
    ];

    protected override void OnInitialized()
    {
        _agent = new UIAgent(ChatClient, options =>
        {
            options.RegisterUIAction(AIFunctionFactory.Create(
                GenerateTaskSteps,
                name: "generate_task_steps",
                description: "Generate a list of task steps for the user to review and approve."));
        });
    }

    private static string GenerateTaskSteps(List<TaskStep> steps)
    {
        if (steps is null || steps.Count == 0)
        {
            return "No steps were provided.";
        }

        var selected = steps
            .Where(s => s.Status != "disabled")
            .Select(s => s.Description)
            .ToList();

        if (selected.Count == 0)
        {
            return "The user rejected all proposed steps.";
        }

        return $"The user selected the following steps: {string.Join(", ", selected)}";
    }

    public void Dispose()
    {
        _agent.Dispose();
    }
}
