@using System.Text.Json
@inject IChatClient ChatClient
@implements IDisposable

<div class="dojo-scenario agentic-generative-ui" data-dojo-scenario="agentic-generative-ui">
    <AgentBoundary @key="_agent" Agent="_agent">
        <div class="sc-ai-root dojo-chat-panel">
            <div class="plan-content">
                <MessageList>
                    <ChildContent>
                        <DojoWelcome />
                    </ChildContent>
                    <Footer Context="context">
                        @if (_agent.State.Value.Steps.Count > 0)
                        {
                            var isRunning = IsRunning(context.Status);
                            <div class="plan-activity"
                                 data-task-status="@(isRunning ? "running" : "done")">
                                <div class="plan-activity__header">
                                    <span class="plan-activity__title">create_plan</span>
                                    <span class="plan-activity__status"
                                          role="status">@(isRunning ? "Running" : "Done")</span>
                                </div>
                                <PlanProgressCard Plan="_agent.State.Value" />
                            </div>
                        }
                        else if (IsRunning(context.Status))
                        {
                            <div class="sc-ai-typing" role="status" aria-label="Agent is typing">
                                <span class="sc-ai-typing__dot"></span>
                                <span class="sc-ai-typing__dot"></span>
                                <span class="sc-ai-typing__dot"></span>
                            </div>
                        }
                    </Footer>
                </MessageList>
            </div>
            <SuggestionList Suggestions="_suggestions" />
            <MessageInput Placeholder="Type a message..." />
        </div>
    </AgentBoundary>
</div>

@code {
    private static readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web);

    private UIAgent<PlanState> _agent = default!;
    private IDisposable? _stateChangedRegistration;

    private static readonly Suggestion[] _suggestions =
    [
        new() { Label = "Simple plan", Prompt = "Please build a plan to go to mars in 5 steps." },
        new() { Label = "Complex plan", Prompt = "Please build a plan to go to make pizza in 10 steps." },
    ];

    protected override void OnInitialized()
    {
        SetAgent(CreateAgent());
    }

    private UIAgent<PlanState> CreateAgent()
    {
        return new UIAgent<PlanState>(ChatClient, options =>
        {
            options.ChatOptions = new ChatOptions
            {
                Tools =
                [
                    AIFunctionFactory.Create(
                        CreatePlan,
                        name: "create_plan",
                        description: "Create a plan with multiple steps."),
                    AIFunctionFactory.Create(
                        UpdatePlanStep,
                        name: "update_plan_step",
                        description: "Update a step in the plan."),
                ],
            };

            options.StateMapper = context =>
            {
                if (context.Update.RawRepresentation is DojoStateDeltaEvent delta)
                {
                    context.SetState(ApplyPlanDelta(_agent.State.Value, delta.Delta));
                    return true;
                }

                var snapshot = context.Update.RawRepresentation switch
                {
                    DojoStateSnapshotEvent snapshotEvent => snapshotEvent.Snapshot,
                    JsonElement directSnapshot => directSnapshot,
                    _ => default,
                };
                if (snapshot.ValueKind == JsonValueKind.Undefined)
                {
                    return false;
                }

                var planState = snapshot.Deserialize<PlanState>(_jsonOptions);
                if (planState is null)
                {
                    return false;
                }

                context.SetState(planState);
                return true;
            };
        });
    }

    private static PlanState CreatePlan(List<string> steps)
        => new()
        {
            Steps =
            [
                .. steps.Select(description => new PlanStep { Description = description }),
            ],
        };

    private static string UpdatePlanStep(
        int index,
        string? description = null,
        string? status = null)
        => $"Updated plan step {index}: {description ?? "unchanged"} ({status ?? "unchanged"}).";

    private static PlanState ApplyPlanDelta(PlanState current, JsonElement delta)
    {
        var next = new PlanState
        {
            Steps =
            [
                .. current.Steps.Select(step => new PlanStep
                {
                    Description = step.Description,
                    Status = step.Status,
                }),
            ],
        };

        foreach (var operation in delta.EnumerateArray())
        {
            if (operation.GetProperty("op").GetString() != "replace")
            {
                continue;
            }

            var pathSegments = operation.GetProperty("path").GetString()?
                .Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (pathSegments is not ["steps", var indexText, var property] ||
                !int.TryParse(indexText, out var index) ||
                index < 0 ||
                index >= next.Steps.Count)
            {
                continue;
            }

            var value = operation.GetProperty("value").GetString() ?? "";
            if (property == "description")
            {
                next.Steps[index].Description = value;
            }
            else if (property == "status")
            {
                next.Steps[index].Status = value;
            }
        }

        return next;
    }

    private void Reset()
    {
        SetAgent(CreateAgent());
    }

    private void SetAgent(UIAgent<PlanState> agent)
    {
        _stateChangedRegistration?.Dispose();
        _agent?.Dispose();
        _agent = agent;
        _stateChangedRegistration = _agent.State.OnChanged(OnStateChanged);
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static bool IsRunning(ConversationStatus status)
        => status is ConversationStatus.Streaming or ConversationStatus.AwaitingInput;

    public void Dispose()
    {
        _stateChangedRegistration?.Dispose();
        _agent?.Dispose();
    }
}
