<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>$(DefaultNetCoreTargetFramework)</TargetFramework>
    <Description>Opt-in automatic pausing of Blazor Server circuits when a browser tab is hidden. Built on the in-box circuit activity primitives.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Microsoft.AspNetCore.Components</RootNamespace>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\Components\Endpoints\src\Microsoft.AspNetCore.Components.Endpoints.csproj" />
  </ItemGroup>

  <!-- The JS initializer (src/js/autopause.lib.module.ts) is bundled by rollup into
       js/dist/$(Configuration) and shipped as a static web asset. Blazor auto-discovers
       *.lib.module.js from referenced Razor class libraries. -->
  <PropertyGroup>
    <InteropWorkingDir>$(MSBuildThisFileDirectory)js\</InteropWorkingDir>
  </PropertyGroup>

  <!-- Match SDK discovery's condition so no-build packing doesn't include the bundles as raw Content. -->
  <Target Name="IncludeCompileJsOutput" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(NoBuild)' != 'true'">
    <ItemGroup>
      <_JsBuildOutput Include="$(InteropWorkingDir)dist\$(Configuration)\**" />
      <Content Include="@(_JsBuildOutput)"
        Link="wwwroot\%(_JsBuildOutput.RecursiveDir)%(_JsBuildOutput.Filename)%(_JsBuildOutput.Extension)"
        ContentRoot="$(InteropWorkingDir)dist\$(Configuration)\" />
    </ItemGroup>
  </Target>

  <!-- Exclude JavaScript sources and configuration files from being packaged as Content -->
  <ItemGroup>
    <Content Remove="js\**\*.ts" />
    <Content Remove="js\babel.config.js" />
    <Content Remove="js\jest.config.js" />
    <Content Remove="js\package.json" />
    <Content Remove="js\rollup.config.mjs" />
    <Content Remove="js\tsconfig.json" />
  </ItemGroup>

</Project>
