<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../Testing/eng/targets/Microsoft.AspNetCore.Components.Testing.props" />

  <PropertyGroup>
    <TargetFramework>$(DefaultNetCoreTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Use xUnit v3 instead of the Arcade SDK's auto-included xUnit v2 -->
    <UsingToolXUnit>false</UsingToolXUnit>
    <GenerateLoggingTestingAssemblyAttributes>false</GenerateLoggingTestingAssemblyAttributes>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <!--
      Publish the app under test instead of launching it with 'dotnet run'. Each test starts
      its own app instance, and concurrent 'dotnet run' invocations rebuild the same project
      and fail on file locks.
    -->
    <E2EAppMode>publish</E2EAppMode>
  </PropertyGroup>

  <!-- Remove auto-added xUnit v2 test infra from CSharp.Common.props -->
  <ItemGroup>
    <Reference Remove="Microsoft.AspNetCore.InternalTesting" />
    <Reference Remove="Moq" />
    <Compile Remove="$(SharedSourceRoot)test\SuccessfulTests.cs" />
  </ItemGroup>

  <!-- Full ASP.NET Core shared framework references for in-process YARP proxy -->
  <ItemGroup>
    <Reference Include="@(AspNetCoreAppReference)" />
    <Reference Include="@(AspNetCoreAppReferenceAndPackage)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Playwright.Xunit.v3" />
    <Reference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.AspNetCore.Components.Testing" />
    <ProjectReference Include="../testassets/AIApp/AIApp.csproj">
      <E2EApp>true</E2EApp>
    </ProjectReference>
  </ItemGroup>

  <!--
    Development layout: point the tasks assembly to the artifacts bin output so that
    Microsoft.AspNetCore.Components.Testing.targets (which only handles the NuGet package
    layout) can find it when building inside the aspnetcore repo.
  -->
  <PropertyGroup>
    <_E2ETasksAssembly Condition="'$(_E2ETasksAssembly)' == '' and Exists('$(ArtifactsBinDir)Microsoft.AspNetCore.Components.Testing.Tasks\$(Configuration)\netstandard2.0\Microsoft.AspNetCore.Components.Testing.Tasks.dll')">$(ArtifactsBinDir)Microsoft.AspNetCore.Components.Testing.Tasks\$(Configuration)\netstandard2.0\Microsoft.AspNetCore.Components.Testing.Tasks.dll</_E2ETasksAssembly>
  </PropertyGroup>

  <!--
    Development layout: add the source generator as an analyzer from the local project.
    When the library is consumed via NuGet the generator is picked up from analyzers/dotnet/cs/.
  -->
  <ItemGroup>
    <ProjectReference
      Include="../../Testing/gen/Microsoft.AspNetCore.Components.Testing.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    E2E tests require Playwright/browser infrastructure, so they are not run by Arcade's
    RunTests target during regular CI builds or on Helix. They are run explicitly by the
    components E2E pipeline.
  -->
  <PropertyGroup>
    <SkipTests>true</SkipTests>
    <BuildHelixPayload>false</BuildHelixPayload>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Baselines\**\*.recording.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="../../Testing/eng/targets/Microsoft.AspNetCore.Components.Testing.targets" />

</Project>
