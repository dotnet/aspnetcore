@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="@typeof(BasicTestApp.Program).Assembly">
    <Found Context="routeData">
        <CascadingStateProvider>
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(NestedLayout)" />
        </CascadingStateProvider>
    </Found>
    <NotFound>
        <p>Layout instantiation route not found.</p>
    </NotFound>
</Router>
