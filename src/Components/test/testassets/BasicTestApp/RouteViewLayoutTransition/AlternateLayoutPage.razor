@page "/route-view-layout-transition/alternate/{Value?}"
@layout RootLayout

<h1 id="page-name">@nameof(AlternateLayoutPage)</h1>
<p>Value: <code id="page-value">@Value</code></p>
<p id="alternate-layout-page-count">@State.AlternateLayoutPages.Count</p>

@code {
    [CascadingParameter]
    public RouteViewLayoutTransitionApp State { get; set; }

    [Parameter]
    public string Value { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        State.AlternateLayoutPages.Add(this);
    }
}
