@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IServiceProvider Services

<button id="start-first" onclick="cancellationTests.start('first', 'wait')">Pass first signal</button>
<button id="abort-first" onclick="cancellationTests.abort('first')">Abort first signal</button>
<button id="start-second" onclick="cancellationTests.start('second', 'wait')">Pass second signal</button>
<button id="release-second" @onclick='() => Release("second")'>Complete second</button>
<button id="start-ignored" onclick="cancellationTests.start('ignored', 'ignore')">Ignore token</button>
<button id="abort-ignored" onclick="cancellationTests.abort('ignored')">Abort ignored signal</button>
<button id="release-ignored" @onclick='() => Release("ignored")'>Complete ignored</button>
<button id="start-preaborted" onclick="cancellationTests.start('preaborted', 'wait', true)">Pass aborted signal</button>
<button id="start-retained" onclick="cancellationTests.start('retained', 'retain')">Retain token</button>
<button id="abort-retained" onclick="cancellationTests.abort('retained')">Abort retained signal</button>
<button id="reuse-retained" onclick="cancellationTests.reuse('retained')">Reuse token reference</button>
<button id="drop-retained" onclick="cancellationTests.drop('retained')">Drop incoming signal</button>
<button id="start-failure" onclick="cancellationTests.start('failure', 'fail')">Fail normally</button>
<button id="start-outgoing" @onclick="SendToken">Pass token to JS</button>
<button id="start-outgoing-pre" @onclick="SendCanceledToken">Pass canceled token</button>
<button id="cancel-outgoing" @onclick="() => outgoingSource.Cancel()">Cancel outgoing token</button>
<button id="start-outgoing-sync" @onclick="SendTokenSynchronously">Pass token to a synchronous JS call</button>
<button id="cancel-outgoing-sync" @onclick="() => syncOutgoingSource.Cancel()">Cancel token of the synchronous call</button>
<button id="drop-outgoing" onclick="cancellationTests.dropOutgoing()">Drop outgoing signal</button>
<button id="start-disposable" @onclick="SendDisposableToken">Pass token of a disposed source</button>
<button id="collect-dotnet" @onclick="CollectThenCallJS">Collect .NET garbage, then call JS</button>
<button id="start-returned" onclick="cancellationTests.returned()">Return token to JS</button>
<button id="cancel-returned" @onclick="() => returnedSource.Cancel()">Cancel returned token</button>
<button id="start-static" onclick="cancellationTests.staticInvocation(false)">Static raw signal</button>
<button id="start-static-pre" onclick="cancellationTests.staticInvocation(true)">Static aborted signal</button>
<button id="start-snapshot" onclick="cancellationTests.snapshot()">Snapshot arguments</button>
<button id="start-concurrent" onclick="cancellationTests.concurrent()">Concurrent shared signal</button>
<button id="start-wrapped" onclick="cancellationTests.wrapped()">Generic signal reference</button>
<button id="start-sync" onclick="cancellationTests.sync()">Synchronous calls</button>
<button id="abort-sync" onclick="cancellationTests.abort('sync')">Abort synchronous signal</button>
<button id="drop-sync" onclick="cancellationTests.drop('sync')">Drop synchronous signal</button>
<button id="start-sync-returned" onclick="cancellationTests.syncReturned()">Return a token canceled during serialization</button>
<button id="start-signal-result" @onclick="ReceiveSignalResult">Receive a signal returned by JS</button>
<button id="start-signal-result-sync" @onclick="ReceiveSignalResultSynchronously">Receive a signal returned by a synchronous JS call</button>
<button id="abort-signal-result" onclick="cancellationTests.abortSignalResult()">Abort the returned signal</button>
<button id="start-overtaken" onclick="cancellationTests.overtaken()">Abort before the delayed call arrives</button>
<button id="start-collected" onclick="cancellationTests.collectedDuringCall(true)">Abort and drop during the delayed call</button>
<button id="start-dropped" onclick="cancellationTests.collectedDuringCall(false)">Drop during the delayed call</button>
<button id="start-blocked" onclick="cancellationTests.start('blocked', 'wait', false, 'normal')">Pass signal whose earlier listener stops the abort event</button>
<button id="abort-blocked" onclick="cancellationTests.abort('blocked')">Abort signal with a stopping listener</button>
<button id="start-blockedcapture" onclick="cancellationTests.start('blockedcapture', 'wait', false, 'capture')">Pass signal whose earlier capture listener stops the abort event</button>
<button id="abort-blockedcapture" onclick="cancellationTests.abort('blockedcapture')">Abort signal with a stopping capture listener</button>
<button id="start-composite" onclick="cancellationTests.composite()">Pass a dropped AbortSignal.any() signal</button>
<button id="abort-composite" onclick="cancellationTests.abort('composite')">Abort the source of the AbortSignal.any() signal</button>
<p id="static-js"></p>
<p id="snapshot-js"></p>
<p id="concurrent-js"></p>
<p id="wrapped-js"></p>
<p id="collected-gc"></p>
<p id="dropped-gc"></p>
<p id="disposable-gc"></p>
<p id="sync-returned-js"></p>
<button id="start-control" @onclick="StartControlCall">Use invocation control token</button>
<button id="cancel-control" @onclick="() => controlSource.Cancel()">Cancel managed wait</button>
<button id="release-control" onclick="cancellationTests.releaseControl()">Complete JS function</button>
<p id="cancellation-ready">@(module is null ? "loading" : "ready")</p>
@foreach (var id in new[] { "first", "second", "ignored", "preaborted", "retained", "failure", "outgoing", "control", "sync", "overtaken", "collected", "dropped", "disposable", "returned", "signalresult", "outgoingsync", "blocked", "blockedcapture", "composite" })
{
    <p id="@($"{id}-managed")">@(states.GetValueOrDefault(id, "not started"))</p>
    <p id="@($"{id}-js")"></p>
    <p id="@($"{id}-listeners")"></p>
}

@code {
    private readonly Dictionary<string, TaskCompletionSource> gates = new();
    private readonly Dictionary<string, string> states = new();
    private readonly List<CancellationTokenRegistration> registrations = new();
    private readonly CancellationTokenSource outgoingSource = new();
    private readonly CancellationTokenSource syncOutgoingSource = new();
    private readonly CancellationTokenSource controlSource = new();
    private readonly CancellationTokenSource returnedSource = new();
    private DotNetObjectReference<InteropCancellationComponent> reference;
    private IJSObjectReference module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            reference = DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cancellation.js");
            await module.InvokeVoidAsync("initialize", reference);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task<string> Receive(CancellationToken cancellationToken, string id, string behavior)
    {
        if (cancellationToken.IsCancellationRequested)
        {
            states[id] = "entered with canceled token";
            await InvokeAsync(StateHasChanged);
            return "pre-canceled result";
        }

        if (behavior == "retain")
        {
            registrations.Add(cancellationToken.Register(() => _ = InvokeAsync(() =>
            {
                states[id] = "canceled after return";
                StateHasChanged();
            })));
            states[id] = "retained";
            await InvokeAsync(StateHasChanged);
            return "returned normally";
        }

        if (behavior == "fail")
        {
            throw new InvalidOperationException("Expected invocation failure");
        }

        var gate = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        gates.Add(id, gate);
        states[id] = "running";
        await InvokeAsync(StateHasChanged);
        try
        {
            if (behavior == "ignore")
            {
                await gate.Task;
            }
            else
            {
                await gate.Task.WaitAsync(cancellationToken);
            }

            states[id] = cancellationToken.IsCancellationRequested ? "completed after cancellation" : "completed";
            return states[id];
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            states[id] = "canceled in .NET";
            return "handler handled cancellation";
        }
        finally
        {
            gates.Remove(id);
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public bool Inspect(CancellationToken cancellationToken) => cancellationToken.IsCancellationRequested;

    [JSInvokable]
    public bool HoldNextInboundActivity()
    {
        var gate = Services.GetService<InboundActivityGate>();
        gate?.HoldNext();
        return gate is not null;
    }

    [JSInvokable]
    public void ReleaseHeldInboundActivity() => Services.GetRequiredService<InboundActivityGate>().ReleaseHeld();

    [JSInvokable]
    public string ReceiveSync(CancellationToken cancellationToken)
    {
        registrations.Add(cancellationToken.Register(() => _ = InvokeAsync(() =>
        {
            states["sync"] = "canceled after return";
            StateHasChanged();
        })));
        return $"{cancellationToken.CanBeCanceled}:{cancellationToken.IsCancellationRequested}";
    }

    [JSInvokable]
    public bool SameTokens(CancellationToken first, CancellationToken second) => first == second;

    [JSInvokable]
    public async Task<bool> ReceiveReference(IJSObjectReference reference)
        => await reference.GetValueAsync<bool>("aborted");

    [JSInvokable]
    public static string StaticYolo(CancellationToken cancellationToken, string value)
        => $"{value}:{cancellationToken.CanBeCanceled}:{cancellationToken.IsCancellationRequested}";

    [JSInvokable]
    public int AutomaticProjectionCount()
    {
        var flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic;
        int Count(string name) => (typeof(JSRuntime).GetField(name, flags)?.GetValue(JS) as System.Collections.ICollection)?.Count ?? 0;
        return Count("_outgoingCancellationTokens") + Count("_abortSignalSources");
    }

    [JSInvokable]
    public string Snapshot(AutomaticArguments value)
        => $"{value.Token.CanBeCanceled}:{string.Join(',', value.Bytes)}:{value.Value}:{value.Metadata.__abortSignalArgument}";

    public sealed class AutomaticArguments
    {
        public CancellationToken Token { get; set; }
        public byte[] Bytes { get; set; }
        public string Value { get; set; }
        public MetadataValue Metadata { get; set; }
    }

    public sealed class MetadataValue
    {
        public int __abortSignalArgument { get; set; }
    }

    private void Release(string id) => gates[id].SetResult();

    private async Task SendToken()
    {
        states["outgoing"] = await module.InvokeAsync<string>("receive", "outgoing", outgoingSource.Token);
    }

    private async Task SendCanceledToken()
    {
        outgoingSource.Cancel();
        await SendToken();
    }

    // Only WebAssembly has synchronous calls to JavaScript.
    private void SendTokenSynchronously()
    {
        states["outgoingsync"] = module is IJSInProcessObjectReference inProcessModule
            ? inProcessModule.Invoke<string>("receive", "outgoingsync", syncOutgoingSource.Token)
            : "no synchronous calls";
    }

    private async Task SendDisposableToken()
    {
        using var source = new CancellationTokenSource();
        states["disposable"] = await module.InvokeAsync<string>("receiveAndForget", "disposable", source.Token);
    }

    // A weak reference is cleared by the collection itself, so no finalizer needs to run.
    private async Task CollectThenCallJS()
    {
        GC.Collect();
        await module.InvokeVoidAsync("noop");
        states["disposable"] = "collected in .NET";
    }

    [JSInvokable]
    public CancellationToken GetReturnedToken() => returnedSource.Token;

    private async Task ReceiveSignalResult()
        => WatchSignalResult(await module.InvokeAsync<CancellationToken>("createSignal"));

    // Only WebAssembly has synchronous calls to JavaScript.
    private void ReceiveSignalResultSynchronously()
    {
        if (module is IJSInProcessObjectReference inProcessModule)
        {
            WatchSignalResult(inProcessModule.Invoke<CancellationToken>("createSignal"));
        }
        else
        {
            states["signalresult"] = "no synchronous calls";
        }
    }

    private void WatchSignalResult(CancellationToken token)
    {
        registrations.Add(token.Register(() => _ = InvokeAsync(() =>
        {
            states["signalresult"] = "canceled in .NET";
            StateHasChanged();
        })));
        states["signalresult"] = $"received:{token.CanBeCanceled}:{token.IsCancellationRequested}";
    }

    // In a synchronous call, returning is the send, so a cancel during serialization reaches JS before the token's id.
    [JSInvokable]
    public CancelingResult GetCancelingResult() => new(new CancellationTokenSource());

    public sealed class CancelingResult(CancellationTokenSource source)
    {
        public CancellationToken Token => source.Token;

        public string Value
        {
            get
            {
                source.Cancel();
                return "canceled";
            }
        }
    }

    private async Task StartControlCall()
    {
        try
        {
            states["control"] = await module.InvokeAsync<string>("waitIgnoringSignal", controlSource.Token, ["control", outgoingSource.Token]);
        }
        catch (OperationCanceledException) when (controlSource.IsCancellationRequested)
        {
            states["control"] = "managed wait canceled";
        }
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var registration in registrations)
        {
            registration.Dispose();
        }

        foreach (var gate in gates.Values)
        {
            gate.TrySetCanceled();
        }

        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("disposeAll");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        reference?.Dispose();
        outgoingSource.Dispose();
        syncOutgoingSource.Dispose();
        controlSource.Dispose();
        returnedSource.Dispose();
    }
}
