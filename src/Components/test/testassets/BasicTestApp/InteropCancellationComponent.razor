@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<button id="start-first" onclick="cancellationTests.start('first', 'wait')">Pass first signal</button>
<button id="abort-first" onclick="cancellationTests.abort('first')">Abort first signal</button>
<button id="start-second" onclick="cancellationTests.start('second', 'wait')">Pass second signal</button>
<button id="release-second" @onclick='() => Release("second")'>Complete second</button>
<button id="start-ignored" onclick="cancellationTests.start('ignored', 'ignore')">Ignore token</button>
<button id="abort-ignored" onclick="cancellationTests.abort('ignored')">Abort ignored signal</button>
<button id="release-ignored" @onclick='() => Release("ignored")'>Complete ignored</button>
<button id="start-preaborted" onclick="cancellationTests.start('preaborted', 'wait', true)">Pass aborted signal</button>
<button id="start-retained" onclick="cancellationTests.start('retained', 'retain')">Retain token</button>
<button id="abort-retained" onclick="cancellationTests.abort('retained')">Abort retained signal</button>
<button id="reuse-retained" onclick="cancellationTests.reuse('retained')">Reuse token reference</button>
<button id="dispose-retained" onclick="cancellationTests.dispose('retained')">Dispose incoming reference</button>
<button id="start-failure" onclick="cancellationTests.start('failure', 'fail')">Fail normally</button>
<button id="start-outgoing" @onclick="SendToken">Pass token to JS</button>
<button id="start-outgoing-pre" @onclick="SendCanceledToken">Pass canceled token</button>
<button id="cancel-outgoing" @onclick="() => outgoingSource.Cancel()">Cancel outgoing token</button>
<button id="dispose-outgoing" @onclick="DisposeOutgoing">Dispose outgoing reference</button>
<button id="start-control" @onclick="StartControlCall">Use invocation control token</button>
<button id="cancel-control" @onclick="() => controlSource.Cancel()">Cancel managed wait</button>
<button id="release-control" onclick="cancellationTests.releaseControl()">Complete JS function</button>
<p id="cancellation-ready">@(module is null ? "loading" : "ready")</p>
@foreach (var id in new[] { "first", "second", "ignored", "preaborted", "retained", "failure", "outgoing", "control" })
{
    <p id="@($"{id}-managed")">@(states.GetValueOrDefault(id, "not started"))</p>
    <p id="@($"{id}-js")"></p>
    <p id="@($"{id}-listeners")"></p>
}

@code {
    private readonly Dictionary<string, TaskCompletionSource> gates = new();
    private readonly Dictionary<string, string> states = new();
    private readonly List<CancellationTokenRegistration> registrations = new();
    private readonly CancellationTokenSource outgoingSource = new();
    private readonly CancellationTokenSource controlSource = new();
    private DotNetObjectReference<InteropCancellationComponent> reference;
    private DotNetCancellationTokenReference outgoing;
    private IJSObjectReference module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            reference = DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cancellation.js");
            await module.InvokeVoidAsync("initialize", reference);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task<string> Receive(CancellationToken cancellationToken, string id, string behavior)
    {
        if (cancellationToken.IsCancellationRequested)
        {
            states[id] = "entered with canceled token";
            await InvokeAsync(StateHasChanged);
            return "pre-canceled result";
        }

        if (behavior == "retain")
        {
            registrations.Add(cancellationToken.Register(() => _ = InvokeAsync(() =>
            {
                states[id] = "canceled after return";
                StateHasChanged();
            })));
            states[id] = "retained";
            await InvokeAsync(StateHasChanged);
            return "returned normally";
        }

        if (behavior == "fail")
        {
            throw new InvalidOperationException("Expected invocation failure");
        }

        var gate = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        gates.Add(id, gate);
        states[id] = "running";
        await InvokeAsync(StateHasChanged);
        try
        {
            if (behavior == "ignore")
            {
                await gate.Task;
            }
            else
            {
                await gate.Task.WaitAsync(cancellationToken);
            }

            states[id] = cancellationToken.IsCancellationRequested ? "completed after cancellation" : "completed";
            return states[id];
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            states[id] = "canceled in .NET";
            return "handler handled cancellation";
        }
        finally
        {
            gates.Remove(id);
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public bool Inspect(CancellationToken cancellationToken) => cancellationToken.IsCancellationRequested;

    private void Release(string id) => gates[id].SetResult();

    private async Task SendToken()
    {
        outgoing = await DotNetCancellationTokenReference.CreateAsync(JS, outgoingSource.Token);
        states["outgoing"] = await module.InvokeAsync<string>("receive", "outgoing", outgoing);
    }

    private async Task SendCanceledToken()
    {
        outgoingSource.Cancel();
        await SendToken();
    }

    private async Task DisposeOutgoing()
    {
        await outgoing.DisposeAsync();
        states["outgoing"] = "reference disposed";
    }

    private async Task StartControlCall()
    {
        outgoing = await DotNetCancellationTokenReference.CreateAsync(JS, outgoingSource.Token);
        try
        {
            states["control"] = await module.InvokeAsync<string>("waitIgnoringSignal", controlSource.Token, ["control", outgoing]);
        }
        catch (OperationCanceledException) when (controlSource.IsCancellationRequested)
        {
            states["control"] = "managed wait canceled";
        }
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var registration in registrations)
        {
            registration.Dispose();
        }

        foreach (var gate in gates.Values)
        {
            gate.TrySetCanceled();
        }

        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("disposeAll");
                if (outgoing is not null)
                {
                    await outgoing.DisposeAsync();
                }

                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        reference?.Dispose();
        outgoingSource.Dispose();
        controlSource.Dispose();
    }
}
