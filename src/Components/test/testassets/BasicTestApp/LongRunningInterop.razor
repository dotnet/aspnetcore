@using Microsoft.JSInterop
@using BasicTestApp.InteropTest
@using System.Runtime.InteropServices
@using System.Text.Json
@inject IJSRuntime JSRuntime

<button id="btn-interop" @onclick="@InvokeInteropAsync">Invoke interop!</button>
<button id="default-timeout" @onclick="() => InvokeWithTimeoutAsync(useDefaultTimeout: true)">Default timeout</button>
<button id="explicit-timeout" @onclick="() => InvokeWithTimeoutAsync(useDefaultTimeout: false)">Explicit timeout</button>
<button id="uncaught-cancellation" @onclick="InvokeUncaughtCancellationAsync">Uncaught cancellation</button>
<button id="observe-cancellation" @onclick="ObserveCancellationAsync">Observe cancellation</button>

@if (DoneWithInterop)
{
    <button id="circuit-functional" @onclick="@DoWork">Circuit still functional</button>
    if (TaskWasCancelled)
    {
        <p id="task-was-cancelled">Task was cancelled.</p>
    }
    <p id="done-with-interop">Done with interop.</p>
}

@if (WorkDone)
{
    <p id="done-circuit-functional">Circuit is functional after client notification completion.</p>
}

@code {
    public bool TaskWasCancelled { get; set; }

    public bool WorkDone { get; set; }

    public bool DoneWithInterop { get; set; }

    public async Task InvokeInteropAsync()
    {
        try
        {
            using var cancellationTokenSource = new System.Threading.CancellationTokenSource(TimeSpan.FromSeconds(1));
            await JSRuntime.InvokeVoidAsync(
                "asyncFunctionTakesLongerThanDefaultTimeoutToResolve",
                cancellationTokenSource.Token,
                Array.Empty<object>());
        }
        catch (TaskCanceledException)
        {
            TaskWasCancelled = true;
        }

        DoneWithInterop = true;
    }

    private Task _cancellationTask = Task.CompletedTask;

    private async Task InvokeWithTimeoutAsync(bool useDefaultTimeout)
    {
        if (useDefaultTimeout)
        {
            await JSRuntime.InvokeVoidAsync("neverCompletingInterop");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("neverCompletingInterop", TimeSpan.FromSeconds(1));
        }
    }

    private Task InvokeUncaughtCancellationAsync()
        => _cancellationTask = InvokeUncaughtCancellationCoreAsync();

    private async Task InvokeUncaughtCancellationCoreAsync()
    {
        using var cancellationTokenSource = new CancellationTokenSource(TimeSpan.FromSeconds(1));
        await JSRuntime.InvokeVoidAsync("neverCompletingInterop", cancellationTokenSource.Token);
    }

    private async Task ObserveCancellationAsync()
    {
        await Task.WhenAny(_cancellationTask);
        TaskWasCancelled = _cancellationTask.IsCanceled;
        DoneWithInterop = true;
    }

    public void DoWork()
    {
        WorkDone = true;
    }
}
