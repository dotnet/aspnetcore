<div id="error-boundary-recovery-@NestingDepth">
    <ErrorBoundary @ref="boundary">
        <ChildContent>
            <ErrorBoundaryRecoveryChild NestingDepth="@NestingDepth" OnAttempt="@(() => attempts++)" />
        </ChildContent>
        <ErrorContent>
            <button class="recover" @onclick="@(() => boundary!.Recover())">Recover (attempt @attempts)</button>
        </ErrorContent>
    </ErrorBoundary>
</div>

@code {
    [Parameter] public int NestingDepth { get; set; }

    private ErrorBoundary boundary;
    private int attempts;
}
