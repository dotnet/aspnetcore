@using Microsoft.AspNetCore.Components.Rendering
<h1>Markup blocks</h1>

<p>
    This component contains blocks of <em>static</em> HTML markup that will be
    represented in the render instructions as single frames.

    This includes nested elements with <span id="attribute-example">attributes</span>.
</p>

<h2>Dynamic markup</h2>

<p>It's also possible to emit markup blocks from render fragments:</p>

<div id="dynamic-markup-block">
    [@((RenderFragment)EmitMarkupBlock)]
</div>

<button @onclick=@(() => { changeOutput = true; })>Change output</button>

<h2>Markup string</h2>

<p>It's also possible to declare a value of a special type that renders as markup:</p>

@((MarkupString)myMarkup)

<h2>Large markup string</h2>
<button id="large-markup-flat" @onclick="() => RenderLargeMarkup(false)">Render flat</button>
<button id="large-markup-wrapped" @onclick="() => RenderLargeMarkup(true)">Render wrapped</button>
<button id="large-markup-orphans" @onclick="RenderMarkupWithOrphans">Render with removals</button>
<button id="large-markup-clear" @onclick="ClearLargeMarkup">Clear</button>
<div id="large-markup">@((MarkupString)largeMarkup)</div>
<div id="markup-relocation-target"></div>
<span id="large-markup-state">@largeMarkupState</span>

@code {
    bool changeOutput;

    string myMarkup = "<p class='markup-string-value'>This is a <em>markup string</em>.</p>";
    string largeMarkup = string.Empty;
    string largeMarkupState = "empty";

    void RenderLargeMarkup(bool wrapped)
    {
        var paragraphs = string.Concat(Enumerable.Range(0, 1000).Select(index => $"<p data-markup-item>{index};</p>"));
        largeMarkup = wrapped ? $"<div>{paragraphs}</div>" : paragraphs;
        largeMarkupState = wrapped ? "wrapped" : "flat";
    }

    void RenderMarkupWithOrphans()
    {
        largeMarkup = string.Concat(Enumerable.Repeat("<span>prefix</span>", 64)) +
            "<p id='markup-moved'>moving</p><p id='markup-removed'>removed</p>" +
            "<script>document.getElementById('markup-relocation-target').appendChild(document.getElementById('markup-moved'));document.getElementById('markup-removed').remove()</script>" +
            "<p id='markup-middle'>middle</p><script>document.getElementById('markup-moved').remove();document.currentScript.remove()</script><p id='markup-last'>last</p>";
        largeMarkupState = "mutated";
    }

    void ClearLargeMarkup()
    {
        largeMarkup = string.Empty;
        largeMarkupState = "empty";
    }

    void EmitMarkupBlock(RenderTreeBuilder builder)
    {
        // To show we detect and apply changes to markup blocks
        if (!changeOutput)
        {
            builder.AddMarkupContent(0, "Here is <strong id='dynamic-element'>an <em>example</em>.</strong> We support multiple-top-level nodes.");
        }
        else
        {
            builder.AddMarkupContent(0, "<span>The output was <em>changed</em></span> completely.");
        }
    }
}
