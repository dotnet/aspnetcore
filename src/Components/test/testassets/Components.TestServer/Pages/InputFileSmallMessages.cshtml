@page "/input-file-small-messages"

<!DOCTYPE html>
<html lang="en">
<head>
    <base href="@Url.Content("~/")" />
    <title>InputFile small message limit</title>
</head>
<body>
    <div id="app"></div>
    <script src="js/jsRootComponentInitializers.js"></script>
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script>
        Blazor.start({ initializers: { beforeStart: [], afterStarted: [] } }).then(() => Blazor.rootComponents.add(
            document.getElementById('app'), 'input-file-metadata', {}));
    </script>
</body>
</html>
