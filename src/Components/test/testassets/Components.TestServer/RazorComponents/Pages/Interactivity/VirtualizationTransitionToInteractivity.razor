@page "/interactivity/virtualization"
@using BasicTestApp
@using TestContentPackage;

@if (TestInitialItemIndex)
{
    <VirtualizationAnchorMode @rendermode="@RenderMode.InteractiveServer" InitialItemIndex="500" />
}
else
{
    <h3>Server</h3>

    <VirtualizedItemList @rendermode="@RenderMode.InteractiveServer" Id="virtualize-server" Items="_items" />

    <h3>WebAssembly</h3>

    <VirtualizedItemList @rendermode="@RenderMode.InteractiveWebAssembly" Id="virtualize-webassembly" Items="_items" />
}

@code {
    private readonly string[] _items = Enumerable.Range(1, 50)
        .Select(i => $"Item {i}")
        .ToArray();

    [Parameter]
    [SupplyParameterFromQuery(Name = "test-initial-item-index")]
    public bool TestInitialItemIndex { get; set; }
}
