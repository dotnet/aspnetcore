@page "/forms/antiforgery-streaming"
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Rendering
@inject Components.TestServer.Services.AsyncOperationService Operations

@if (Destination is not null)
{
    <a id="cross-site-link" href="@Destination" target="_blank">Open streaming page</a>
}
else
{
    <p id="fetch-site">@HttpContext.Request.Headers["Sec-Fetch-Site"]</p>
    <p id="received-cookie">@HttpContext.Request.Cookies.Keys.Any(name => name.StartsWith(".AspNetCore.Antiforgery.", StringComparison.Ordinal))</p>
    @if (!ready)
    {
        <p id="waiting">Waiting for release</p>
        @if (InteractiveLoading)
        {
            <InteractiveLoadingComponent @rendermode="RenderMode.InteractiveServer" Id="@Id" />
        }
    }
    else
    {
        <p id="released">Released</p>
        @if (RenderForm)
        {
            <form method="post" @formname="LateForm" @onsubmit="() => submitted = true">
                <AntiforgeryToken />
                <button id="send" type="submit">Send</button>
            </form>
        }
    }
    @if (InteractiveLoading)
    {
        <p id="loading-initialized">@HttpContext.Items.ContainsKey("interactive-loading-initialized")</p>
    }
    @if (RetainInteractiveComponent)
    {
        <TestContentPackage.Counter @rendermode="RenderMode.InteractiveServer" IdSuffix="retained" IncrementAmount="1" />
    }
    @if (submitted)
    {
        <p id="pass">Form submitted!</p>
    }
}

@code {
    [SupplyParameterFromQuery] public string Destination { get; set; }
    [SupplyParameterFromQuery] public string Id { get; set; }
    [SupplyParameterFromQuery] public bool RenderForm { get; set; }
    [SupplyParameterFromQuery] public bool InteractiveLoading { get; set; }
    [SupplyParameterFromQuery] public bool RetainInteractiveComponent { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; }

    private bool ready;
    private bool submitted;

    protected override async Task OnInitializedAsync()
    {
        if (Destination is null && !HttpMethods.IsPost(HttpContext.Request.Method))
        {
            var operation = Operations.Start(Id);
            if (!InteractiveLoading)
            {
                Operations.Complete($"{Id}-started");
            }
            await operation.WaitAsync(HttpContext.RequestAborted);
        }
        ready = true;
    }

    public sealed class InteractiveLoadingComponent : ComponentBase
    {
        [Parameter] public string Id { get; set; }
        [CascadingParameter] private HttpContext HttpContext { get; set; }
        [Inject] private Components.TestServer.Services.AsyncOperationService Operations { get; set; }

        protected override void OnInitialized()
        {
            HttpContext.Items["interactive-loading-initialized"] = true;
            Operations.Complete($"{Id}-started");
        }

        protected override void BuildRenderTree(RenderTreeBuilder builder)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "id", "interactive-loading");
            builder.AddContent(2, "Interactive loading content");
            builder.CloseElement();
        }
    }
}
