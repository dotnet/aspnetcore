@page "/forms/streaming-rendering/{OperationId}"
@attribute [StreamRendering]
@inject AsyncOperationService AsyncOperation
@inject NavigationManager Navigation;
@using Components.TestServer.Services;
@using System.Collections.Concurrent
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Mvc;
@using Microsoft.Extensions.Configuration
@using TestContentPackage
@inject IConfiguration Configuration

<h2>Streaming rendering async form</h2>

@if (Configuration.GetValue<bool>("BrowserConfigurationDisableOnFormPost") && HttpContext.Request.Method == "POST")
{
    <ConfigureBrowser Options="@_disableDomOptions" />
    <p id="browser-options-post-count">@_postCount</p>
}

@if (Configuration.GetValue<bool>("BrowserConfigurationDisableOnFormPost"))
{
    <Counter @rendermode="RenderMode.InteractiveServer" IdSuffix="form" IncrementAmount="1" />
}

<EditForm Enhance EditContext="_editContext" method="POST" OnValidSubmit="HandleSubmit" FormName="someform">
    <input id="send" type="submit" value="Send" />
</EditForm>

@if (_submitting)
{
    <p id="progress">Form submitting!</p>
}
else if (_submitted)
{
    <p id="pass">Form submitted!</p>
}

@code {
    private static readonly BrowserOptions _disableDomOptions = new() { StaticServer = { PreserveDom = false } };
    private static readonly ConcurrentDictionary<string, int> _postCounts = new();
    private int _postCount;
    bool _submitted = false;
    bool _submitting = false;
    EditContext _editContext = new EditContext(new object());
    [Parameter] public string? OperationId { get; set; }
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (Configuration.GetValue<bool>("BrowserConfigurationDisableOnFormPost") &&
            HttpContext.Request.Method == "POST" && OperationId is { } operationId)
        {
            _postCount = _postCounts.AddOrUpdate(operationId, 1, (_, count) => count + 1);
        }
    }

    public async Task HandleSubmit()
    {
        _submitting = true;
        await AsyncOperation.Start(OperationId);
        _submitting = false;
        _submitted = true;
    }

    public static void MapEndpoints(IEndpointRouteBuilder endpoints)
    {
        endpoints.MapPost(
            "/forms/streaming-rendering/complete/{operationId}",
            ([FromServices] AsyncOperationService asyncOperation, [FromRoute] string operationId) =>
            {
                asyncOperation.Complete(operationId);
            });
    }
}
