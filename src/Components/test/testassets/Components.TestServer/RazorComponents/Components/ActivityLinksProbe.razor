@using System.Diagnostics

<div id="activity-links-probe">
    <span id="activity-links-probe-instance">@_instanceId</span>
    <span id="activity-links-probe-interactive">@_interactive</span>
    <button id="activity-links-capture" @onclick="CaptureActivity">Capture activity</button>
    <span id="activity-links-route">@_route</span>
    <span id="activity-links-count">@_linkCount</span>
</div>

@code {
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private bool _interactive;
    private string? _route;
    private int? _linkCount;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
        }
    }

    private void CaptureActivity()
    {
        _ = CaptureActivityAfterEventAsync(Activity.Current);
    }

    private async Task CaptureActivityAfterEventAsync(Activity? activity)
    {
        while (activity is { IsStopped: false })
        {
            await Task.Delay(10);
        }

        await InvokeAsync(() =>
        {
            _route = activity?.GetTagItem("aspnetcore.components.route") as string;
            _linkCount = activity?.Links.Count();
            ComponentsActivityTestListener.Disable();
            StateHasChanged();
        });
    }
}
