<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <BasePath />

    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</head>

<body>
    <Components.WasmMsalRemoteAuthentication.Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="@Assets["_content/Microsoft.Authentication.WebAssembly.Msal/AuthenticationService.js"]"></script>
    <script>
        const signIn = AuthenticationService.signIn.bind(AuthenticationService);
        AuthenticationService.signIn = state => {
            window.__msalSignInCalled = true;
            return signIn(state);
        };

        Blazor.start({
            webAssembly: {
                loadBootResource: (type, name, defaultUri, integrity) => `WasmMsalRemoteAuthentication/_framework/${name}`
            }
        });
    </script>
</body>

</html>
