<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <BasePath />

    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</head>

<body>
    <Components.WasmRemoteAuthentication.Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="@Assets["_content/Microsoft.AspNetCore.Components.WebAssembly.Authentication/AuthenticationService.js"]"></script>
    <script>
        const completeSignIn = AuthenticationService.completeSignIn.bind(AuthenticationService);
        AuthenticationService.completeSignIn = async (...args) => {
            const result = await completeSignIn(...args);
            if (window.self !== window.top) {
                window.top.__authenticationCallbackCompletedInIframe = true;
            }
            return result;
        };

        Blazor.start({
            webAssembly: {
                loadBootResource: (type, name, defaultUri, integrity) => `WasmRemoteAuthentication/_framework/${name}`
            }
        });
    </script>
</body>

</html>
