<section id="position-root">
    @if (show)
    {
        <div id="position-scope">
            @switch (Scenario)
            {
                case "nested":
                    @if (RendererInfo.IsInteractive)
                    {
                        <strong id="@("position-change")">Ready</strong>
                    }
                    else
                    {
                        <span id="@("position-change")">Preparing</span>
                    }
                    break;
                case "input-default":
                    <input id="position-changed-input" value="@(RendererInfo.IsInteractive ? "Carol" : "Alice")" />
                    break;
                case "textarea-default":
                    <textarea id="position-changed-input" value="@(RendererInfo.IsInteractive ? "Carol" : "Alice")"></textarea>
                    break;
                case "textarea-text":
                case "textarea-text-matching":
                    <textarea id="position-changed-input" @ref="textarea">@(Scenario == "textarea-text" && RendererInfo.IsInteractive ? "Carol" : "Alice")</textarea>
                    break;
                case "markup-textarea":
                    @((MarkupString)$"<textarea id=\"position-changed-input\">{(RendererInfo.IsInteractive ? "Carol" : "Alice")}</textarea>")
                    break;
                case "remove-leading":
                    @if (!RendererInfo.IsInteractive)
                    {
                        <span id="@("position-leading")">Before</span>
                    }
                    break;
                case "add-leading":
                    @if (RendererInfo.IsInteractive)
                    {
                        <span id="@("position-leading")">Before</span>
                    }
                    break;
                case "remove-middle":
                case "insert-middle":
                    <div id="position-list">
                        @foreach (var item in (Scenario == "remove-middle") == RendererInfo.IsInteractive ? new[] { 1, 3 } : new[] { 1, 2, 3 })
                        {
                            <span id="@($"position-item-{item}")">@item</span>
                        }
                    </div>
                    break;
                case "text":
                    @("Hello ")@(RendererInfo.IsInteractive ? "Carol" : "Alice")
                    break;
                case "component":
                    <PrerenderedDomPositionChild Changed="RendererInfo.IsInteractive" />
                    break;
                case "empty-component":
                    <PrerenderedDomPositionChild Empty="RendererInfo.IsInteractive" />
                    break;
                case "markup-tree":
                    @((MarkupString)$"<div id=\"position-markup\"><{(RendererInfo.IsInteractive ? "strong" : "span")}>State</{(RendererInfo.IsInteractive ? "strong" : "span")}><input id=\"position-markup-note\" value=\"Alice\"></div>")
                    break;
                case "markup-siblings":
                    @((MarkupString)$"<{(RendererInfo.IsInteractive ? "strong" : "span")}>State</{(RendererInfo.IsInteractive ? "strong" : "span")}><input id=\"position-markup-note\" value=\"Alice\"><i>After</i>")
                    break;
                case "table":
                    <table id="position-table"><tr><td>@Scenario</td></tr></table>
                    break;
                case "script-order":
                case "unchanged-script-changed-target":
                case "matching-script":
                    @if (Scenario == "script-order" && RendererInfo.IsInteractive)
                    {
                        <span>Interactive insertion</span>
                    }
                    <button id="position-target" data-phase="@RenderPhase" type="button">Native target</button>
                    @((MarkupString)ClickListenerScript)
                    break;
                case "custom-element-order":
                case "unchanged-custom-element-changed-target":
                case "matching-custom-element":
                    <button id="position-target" data-phase="@RenderPhase" type="button">Native target</button>
                    @((MarkupString)(Scenario == "custom-element-order" && !RendererInfo.IsInteractive
                        ? "<span>Before</span>"
                        : "<prerendered-position-connector></prerendered-position-connector>"))
                    break;
                case "nested-script-order":
                case "nested-script-subtree":
                case "unchanged-nested-script-changed-target":
                    @((MarkupString)$"<div id=\"position-initializer\" data-phase=\"{(Scenario == "nested-script-subtree" ? RenderPhase : "same")}\">{(Scenario == "nested-script-order" && RendererInfo.IsInteractive ? "<span>Interactive insertion</span>" : "")}<button id=\"position-target\" data-phase=\"{RenderPhase}\" type=\"button\">Native target</button>{ClickListenerScript}</div>")
                    break;
            }
            <input id="position-note" value="Alice" />
        </div>
    }
    <footer id="position-footer"><input id="position-footer-note" value="Alice" /></footer>
    <button id="position-increment" @onclick="() => count++">Count: @count</button>
    <button id="position-toggle" @onclick="() => show = !show">Toggle</button>
    <span id="position-ready">@ready</span>
    @if (Scenario is "script-order" or "unchanged-script-changed-target" or "matching-script" or
        "custom-element-order" or "unchanged-custom-element-changed-target" or "matching-custom-element" or
        "nested-script-order" or "nested-script-subtree" or "unchanged-nested-script-changed-target")
    {
        <output id="position-native-status">Not clicked</output>
    }
</section>

@code {
    [Parameter] public string Scenario { get; set; }

    private int count;
    private bool show = true;
    private ElementReference textarea;
    private string ready = "";

    private string RenderPhase => Scenario is "matching-script" or "matching-custom-element" ? "same" : RendererInfo.Name;

    private const string ClickListenerScript = """
        <script>
            window.prerenderedPositionInitializerRuns = (window.prerenderedPositionInitializerRuns || 0) + 1;
            window.prerenderedPositionInitializedTarget = document.getElementById('position-target');
            window.prerenderedPositionInitializedTarget.addEventListener('click', function () {
                window.prerenderedPositionNativeClicks = (window.prerenderedPositionNativeClicks || 0) + 1;
                document.getElementById('position-native-status').textContent = 'Clicked';
            });
        </script>
        """;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ready = RendererInfo.Name;
            StateHasChanged();
        }
    }
}
