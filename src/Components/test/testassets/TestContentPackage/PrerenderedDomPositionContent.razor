<section id="position-root">
    @if (show)
    {
        <div id="position-scope">
            @switch (Scenario)
            {
                case "input-default":
                    <input id="position-changed-input" value="@(RendererInfo.IsInteractive ? "Carol" : "Alice")" />
                    break;
                case "textarea-default":
                    <textarea id="position-changed-input" value="@(RendererInfo.IsInteractive ? "Carol" : "Alice")"></textarea>
                    <textarea id="position-changed-textarea" @ref="textarea">@(RendererInfo.IsInteractive ? "Carol" : "Alice")</textarea>
                    <textarea id="position-matching-textarea">Alice</textarea>
                    break;
                case "remove-leading":
                    @if (!RendererInfo.IsInteractive)
                    {
                        <span id="@("position-leading")">Before</span>
                    }
                    break;
                case "component":
                    <PrerenderedDomPositionChild Changed="RendererInfo.IsInteractive" />
                    break;
                case "markup-tree":
                    @((MarkupString)$"<div id=\"position-markup\"><{(RendererInfo.IsInteractive ? "strong" : "span")}>State</{(RendererInfo.IsInteractive ? "strong" : "span")}><input id=\"position-markup-note\" value=\"Alice\"><textarea id=\"position-changed-textarea\">{(RendererInfo.IsInteractive ? "Carol" : "Alice")}</textarea></div>")
                    break;
                case string selectScenario when selectScenario.StartsWith("select-", StringComparison.Ordinal):
                    <select id="position-select"
                            multiple="@(Scenario == "select-multiple-matching")"
                            value="@SelectValue">
                        @if (Scenario == "select-dynamic-options")
                        {
                            @foreach (var value in new[] { "5 min", "15 min", "30 min", "45 min", "60+ min" })
                            {
                                <option value="@value">@value</option>
                            }
                        }
                        else if (Scenario is "select-selected-option" or "select-multiple-matching")
                        {
                            <option selected="@(Scenario == "select-multiple-matching")">5 min</option>
                            <option>15 min</option>
                            <option>30 min</option>
                            <option selected>45 min</option>
                            <option>60+ min</option>
                        }
                        else if (Scenario == "select-disabled-optgroup")
                        {
                            <optgroup disabled><option>5 min</option></optgroup>
                            <option>45 min</option>
                            <option>15 min</option>
                            <option>30 min</option>
                        }
                        else
                        {
                            <option>5 min</option>
                            <option>15 min</option>
                            <option>30 min</option>
                            <option>45 min</option>
                            <option>60+ min</option>
                        }
                    </select>
                    <button id="position-select-update" @onclick="UpdateSelectValue">Select 15 min</button>
                    break;
                case "script-order":
                    @if (RendererInfo.IsInteractive)
                    {
                        <span>Interactive insertion</span>
                    }
                    <button id="position-target" data-phase="@RendererInfo.Name" type="button">Native target</button>
                    @((MarkupString)ClickListenerScript)
                    break;
                case "form-reset":
                    <form id="reset-form">
                        <input id="reset-text" value="@resetText" />
                        <input id="reset-pristine" value="@initialText" />
                        <input id="reset-check" type="checkbox" checked="@resetChecked" value="Check value" />
                        <input id="reset-pristine-check" type="checkbox" checked="@initialChecked" />
                        <input id="reset-radio-first" type="radio" name="reset-radio" checked="@initialChecked" value="First" />
                        <input id="reset-radio-second" type="radio" name="reset-radio" checked="@(!initialChecked)" value="Second" />
                        <input id="reset-range" type="range" min="0" max="100" value="@initialRange" />
                        <input id="reset-number" type="number" value="@initialRange" />
                        <input id="reset-hidden" type="hidden" value="@hiddenValue" />
                        <input id="reset-button" type="button" value="@buttonCaption" />
                        <input id="reset-file" type="file" value="@emptyValue" />
                        @((MarkupString)"<input id=\"reset-markup\" value=\"Markup default\">")
                        <button id="reset-update" type="button" @onclick="UpdateResetInputs">Update</button>
                        <button id="reset-native" type="reset">Reset</button>
                    </form>
                    break;
            }
            <input id="position-note" value="Alice" />
        </div>
    }
    <footer id="position-footer"><input id="position-footer-note" value="Alice" /></footer>
    <button id="position-increment" @onclick="() => count++">Count: @count</button>
    <button id="position-toggle" @onclick="() => show = !show">Toggle</button>
    <span id="position-ready">@ready</span>
    @if (Scenario == "script-order")
    {
        <output id="position-native-status">Not clicked</output>
    }
</section>

@code {
    [Parameter] public string Scenario { get; set; }

    private int count;
    private bool show = true;
    private ElementReference textarea;
    private string ready = "";
    private string selectValue;
    private string resetText = "Initial";
    private bool resetChecked = true;
    private string initialText = "Initial";
    private bool initialChecked = true;
    private string initialRange = "20";
    private string hiddenValue = "Hidden value";
    private string buttonCaption = "Button caption";
    private string emptyValue = "";

    private string SelectValue => selectValue ?? (Scenario switch
    {
        "select-text-options-matching" => "5 min",
        "select-no-value" => null,
        "select-multiple-matching" => "[\"5 min\",\"45 min\"]",
        _ => "45 min",
    });

    private void UpdateSelectValue()
        => selectValue = Scenario == "select-multiple-matching" ? "[\"15 min\"]" : "15 min";

    private void UpdateResetInputs()
    {
        resetText = "Changed";
        resetChecked = false;
    }

    private const string ClickListenerScript = """
        <script>
            window.prerenderedPositionInitializerRuns = (window.prerenderedPositionInitializerRuns || 0) + 1;
            window.prerenderedPositionInitializedTarget = document.getElementById('position-target');
            window.prerenderedPositionInitializedTarget.addEventListener('click', function () {
                window.prerenderedPositionNativeClicks = (window.prerenderedPositionNativeClicks || 0) + 1;
                document.getElementById('position-native-status').textContent = 'Clicked';
            });
        </script>
        """;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ready = RendererInfo.Name;
            StateHasChanged();
        }
    }
}
