<section id="position-root">
    @if (show)
    {
        <div id="position-scope">
            @switch (Scenario)
            {
                case "nested":
                    @if (RendererInfo.IsInteractive)
                    {
                        <strong id="@("position-change")">Ready</strong>
                    }
                    else
                    {
                        <span id="@("position-change")">Preparing</span>
                    }
                    break;
                case "input-default":
                    <input id="position-changed-input" value="@(RendererInfo.IsInteractive ? "Carol" : "Alice")" />
                    break;
                case "textarea-default":
                    <textarea id="position-changed-input" value="@(RendererInfo.IsInteractive ? "Carol" : "Alice")"></textarea>
                    break;
                case "textarea-text":
                case "textarea-text-matching":
                    <textarea id="position-changed-input" @ref="textarea">@(Scenario == "textarea-text" && RendererInfo.IsInteractive ? "Carol" : "Alice")</textarea>
                    break;
                case "markup-textarea":
                    @((MarkupString)$"<textarea id=\"position-changed-input\">{(RendererInfo.IsInteractive ? "Carol" : "Alice")}</textarea>")
                    break;
                case "remove-leading":
                    @if (!RendererInfo.IsInteractive)
                    {
                        <span id="@("position-leading")">Before</span>
                    }
                    break;
                case "add-leading":
                    @if (RendererInfo.IsInteractive)
                    {
                        <span id="@("position-leading")">Before</span>
                    }
                    break;
                case "remove-middle":
                case "insert-middle":
                    <div id="position-list">
                        @foreach (var item in (Scenario == "remove-middle") == RendererInfo.IsInteractive ? new[] { 1, 3 } : new[] { 1, 2, 3 })
                        {
                            <span id="@($"position-item-{item}")">@item</span>
                        }
                    </div>
                    break;
                case "text":
                    @("Hello ")@(RendererInfo.IsInteractive ? "Carol" : "Alice")
                    break;
                case "component":
                    <PrerenderedDomPositionChild Changed="RendererInfo.IsInteractive" />
                    break;
                case "empty-component":
                    <PrerenderedDomPositionChild Empty="RendererInfo.IsInteractive" />
                    break;
                case "markup-tree":
                    @((MarkupString)$"<div id=\"position-markup\"><{(RendererInfo.IsInteractive ? "strong" : "span")}>State</{(RendererInfo.IsInteractive ? "strong" : "span")}><input id=\"position-markup-note\" value=\"Alice\"></div>")
                    break;
                case "markup-siblings":
                    @((MarkupString)$"<{(RendererInfo.IsInteractive ? "strong" : "span")}>State</{(RendererInfo.IsInteractive ? "strong" : "span")}><input id=\"position-markup-note\" value=\"Alice\"><i>After</i>")
                    break;
                case "table":
                    <table id="position-table"><tr><td>@Scenario</td></tr></table>
                    break;
            }
            <input id="position-note" value="Alice" />
        </div>
    }
    <footer id="position-footer"><input id="position-footer-note" value="Alice" /></footer>
    <button id="position-increment" @onclick="() => count++">Count: @count</button>
    <button id="position-toggle" @onclick="() => show = !show">Toggle</button>
    <span id="position-ready">@ready</span>
</section>

@code {
    [Parameter] public string Scenario { get; set; }

    private int count;
    private bool show = true;
    private ElementReference textarea;
    private string ready = "";

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ready = RendererInfo.Name;
            StateHasChanged();
        }
    }
}
