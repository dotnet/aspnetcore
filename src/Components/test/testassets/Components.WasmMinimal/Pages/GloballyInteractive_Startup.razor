@page "/globally-interactive/startup/{PageName}"
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation
@inject IServiceProvider Services

<h1>@PageName</h1>
<ShowExecutionMode />
<p id="navigation-uri">@Navigation.Uri</p>
<p id="history-entry-state">@Navigation.HistoryEntryState</p>
<p id="startup-notification-count">@StartupState?.NotificationCount</p>
<p id="startup-notification-uri">@StartupState?.Location</p>
<p id="startup-notification-intercepted">@StartupState?.IsNavigationIntercepted</p>
<a id="next-page" href="globally-interactive/startup/@(PageName == "Home" ? "Counter" : "Final")">Next page</a>
<a id="redirect-page" href="globally-interactive/startup-redirect">Redirect to Counter</a>
<button id="increment" @onclick="() => count++">Increment</button>
<p id="count">@count</p>

@code {
    [Parameter]
    public string PageName { get; set; } = default!;

    private int count = 0;

    private StartupNavigationState? StartupState => Services.GetService<StartupNavigationState>();
}
