@page "/mcp-gated"
@using BlazorMcpProof
@using global::Components.McpTestApp.Hosting
@inject McpFormEffects Effects
@inject McpScopeProbe Scope
@inject FormActionGate Gate
@inject FormOperationCancellation Cancellation
@implements IDisposable

<form method="post" @formname="gated" @onsubmit="Submit">
    <AntiforgeryToken />
    <input type="hidden" name="Case" value="@ActiveCase" />
    <button id="gated-submit" type="submit">Run gated action</button>
</form>
<a id="gated-next" href="mcp-form?case=gated-next">Navigate while the action is pending</a>
<p id="gated-result">@result</p>

@code {
    private string? result;

    [SupplyParameterFromQuery(Name = "case")]
    public string? QueryCase { get; set; }

    [SupplyParameterFromForm(Name = "Case")]
    private string? FormCase { get; set; }

    private string ActiveCase => FormCase ?? QueryCase ?? "gated";

    protected override void OnInitialized()
    {
        Scope.CaseId = ActiveCase;
        Effects.ComponentCreated(ActiveCase);
    }

    private async Task Submit()
    {
        await Gate.WaitAsync(ActiveCase, Cancellation.CancellationToken);
        Effects.Record(ActiveCase, "completed");
        result = "completed";
    }

    public void Dispose() => Effects.ComponentDisposed(ActiveCase);
}
