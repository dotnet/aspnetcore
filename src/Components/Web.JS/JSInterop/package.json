{
  "name": "@microsoft/dotnet-js-interop",
  "version": "11.0.0-dev",
  "description": "Provides abstractions and features for interop between .NET and JavaScript code.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && npm run build:esm",
    "build:esm": "tsc --project ./tsconfig.json",
    "get-version": "node -e \"const { name, version } = require('./package.json'); console.log(`${name};${version}`);\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotnet/aspnetcore.git"
  },
  "author": "Microsoft",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dotnet/aspnetcore/issues"
  },
  "homepage": "https://github.com/dotnet/aspnetcore/tree/main/src/Components/Web.JS/JSInterop",
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-typescript": "^7.26.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "eslint-plugin-jsdoc": "^46.9.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.3.3"
  }
}
