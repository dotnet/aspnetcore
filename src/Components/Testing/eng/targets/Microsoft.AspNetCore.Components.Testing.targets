<!--
  Microsoft.AspNetCore.Components.Testing.targets
  ============================
  Reusable MSBuild targets for E2E test projects. Generates a JSON manifest
  describing all Blazor app projects under test and prepares them at build time.

  Usage:
  ======
  Add <PackageReference Include="Microsoft.AspNetCore.Components.Testing" /> to the test project.
  The props and targets are auto-imported via buildTransitive.

  Tag each app ProjectReference with E2EApp metadata:
       <ProjectReference Include="..\MyApp\MyApp.csproj">
         <E2EApp>true</E2EApp>
         <E2EPublicUrl>https://localhost:5001</E2EPublicUrl>  (optional)
         <E2EAppMode>publish</E2EAppMode>                 (optional; overrides the global default)
       </ProjectReference>

  Build normally for dev/build mode (dotnet run from the app's working directory):
       dotnet test

  Build with E2EAppMode=publish for published mode:
       dotnet test -p:E2EAppMode=publish

  Build with E2EAppMode=all for both source and published:
       dotnet test -p:E2EAppMode=all

  E2EAppMode controls what lands in e2e-apps/:
    build   (default) — copies project source for 'dotnet run' (works locally and after publish).
    publish           — publishes the app (native exe / framework-dependent) for faster startup.
    all               — both: source in e2e-apps/<name>/, published in e2e-apps/publish/<name>/.

  Local dev (Build): manifest uses absolute paths to source, nothing is copied.
  Publish:           manifest uses relative paths, everything flows to $(PublishDir).

  Native AOT:
    Configure and restore the app project for Native AOT and its supported RuntimeIdentifiers.
    Set E2ENativeAot=true and E2ERuntimeIdentifier=<selected RID> on the ProjectReference.

  The test fixture reads the manifest at runtime to determine how to launch each app.
-->
<Project>

  <!--
    MSBuild task: GenerateE2EManifest (from compiled task assembly).
    When consumed via NuGet, the task DLL is in the tasks/ folder of the package.
    Set _E2ETasksAssembly before importing this file to use a different task location.
  -->
  <PropertyGroup>
    <!-- NuGet package layout: buildTransitive/net10.0/ (MSBuildThisFileDirectory) → ../../tasks/ -->
    <_E2ETasksAssembly Condition="'$(_E2ETasksAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)../../tasks/netstandard2.0/Microsoft.AspNetCore.Components.Testing.Tasks.dll')">$(MSBuildThisFileDirectory)../../tasks/netstandard2.0/Microsoft.AspNetCore.Components.Testing.Tasks.dll</_E2ETasksAssembly>
  </PropertyGroup>

  <UsingTask
    TaskName="Microsoft.AspNetCore.Components.Testing.Tasks.GenerateE2EManifest"
    AssemblyFile="$(_E2ETasksAssembly)"
    Condition="'$(_E2ETasksAssembly)' != ''" />

  <!--
    Inject the artifacts directory into the test assembly as an
    [assembly: AssemblyMetadata("Microsoft.AspNetCore.Components.Testing.ArtifactsPath", ...)]
    value. TestArtifactDirectory reads this to route test artifacts into a
    build/output location instead of the machine temp folder.
  -->
  <Target Name="_AddE2EArtifactsAssemblyMetadata"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(E2EArtifactsPath)' != ''">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Microsoft.AspNetCore.Components.Testing.ArtifactsPath</_Parameter1>
        <_Parameter2>$(E2EArtifactsPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!--
    Target: PrepareE2EApps
    Runs after Build. During Publish, _PreparePublishedE2EApps invokes it in a
    separate project instance so publish output is prepared deterministically.
    Depending on E2EAppMode, copies source and/or publishes each E2EApp project,
    then generates the manifest.

    On Build: output goes to $(OutputPath) (local dev).
    On Publish: output goes to $(PublishDir).
    Follows the same pattern as FunctionalTestWithAssets.targets.
  -->
  <Target
    Name="PrepareE2EApps"
    DependsOnTargets="PrepareProjectReferences"
    AfterTargets="Build">

    <PropertyGroup>
      <_E2EIsPublishing Condition="'$(_E2EIsPublishing)' == ''">false</_E2EIsPublishing>
      <_E2EOutputRoot Condition="'$(_E2EIsPublishing)' == 'true'">$(PublishDir)</_E2EOutputRoot>
      <_E2EOutputRoot Condition="'$(_E2EIsPublishing)' != 'true'">$(OutputPath)</_E2EOutputRoot>
      <_E2EAppsOutputDir>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(_E2EOutputRoot)', '$(E2EAppsRelativeDir)'))</_E2EAppsOutputDir>
      <_ManifestPath>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(_E2EOutputRoot)', '$(AssemblyName).e2e-manifest.json'))</_ManifestPath>
    </PropertyGroup>

    <!-- Resolve each app's effective mode, then split source and publish work. -->
    <ItemGroup>
      <_E2EAppProjects Include="@(_MSBuildProjectReferenceExistent)" Condition="'%(_MSBuildProjectReferenceExistent.E2EApp)' == 'true'" />
      <_E2EAppProjects Condition="'%(_E2EAppProjects.E2EAppMode)' == ''">
        <E2EAppMode>$(E2EAppMode)</E2EAppMode>
      </_E2EAppProjects>
      <_E2ESourceAppProjects Include="@(_E2EAppProjects)" Condition="'%(_E2EAppProjects.E2EAppMode)' == 'build' or '%(_E2EAppProjects.E2EAppMode)' == 'all'" />
      <_E2EPublishPrimaryAppProjects Include="@(_E2EAppProjects)" Condition="'%(_E2EAppProjects.E2EAppMode)' == 'publish'" />
      <_E2EPublishSecondaryAppProjects Include="@(_E2EAppProjects)" Condition="'%(_E2EAppProjects.E2EAppMode)' == 'all' and '%(_E2EAppProjects.E2ENativeAot)' != 'true'" />
      <_E2ENativeAotAppProjects Include="@(_E2EAppProjects)" Condition="'%(_E2EAppProjects.E2ENativeAot)' == 'true'" />
      <_E2EManagedPrimaryAppProjects Include="@(_E2EPublishPrimaryAppProjects)" Condition="'%(_E2EPublishPrimaryAppProjects.E2ENativeAot)' != 'true'" />
      <_E2EManagedPrimaryAppProjects>
        <AdditionalProperties>%(_E2EManagedPrimaryAppProjects.AdditionalProperties);PublishDir=$([System.IO.Path]::Combine('$(_E2EAppsOutputDir)', '%(_E2EManagedPrimaryAppProjects.Filename)'))/</AdditionalProperties>
      </_E2EManagedPrimaryAppProjects>
      <_E2ENativeAotAppProjects>
        <AdditionalProperties>%(_E2ENativeAotAppProjects.AdditionalProperties);PublishDir=$([System.IO.Path]::Combine('$(_E2EAppsOutputDir)', '%(_E2ENativeAotAppProjects.Filename)'))/;E2ECompileTestHarness=true;RuntimeIdentifier=%(_E2ENativeAotAppProjects.E2ERuntimeIdentifier)</AdditionalProperties>
      </_E2ENativeAotAppProjects>
      <_E2EPublishSecondaryAppProjects>
        <AdditionalProperties>%(_E2EPublishSecondaryAppProjects.AdditionalProperties);PublishDir=$([System.IO.Path]::Combine('$(_E2EAppsOutputDir)', 'publish', '%(_E2EPublishSecondaryAppProjects.Filename)'))/</AdditionalProperties>
      </_E2EPublishSecondaryAppProjects>
    </ItemGroup>

    <Error
      Text="E2EApp ProjectReference '%(_E2EAppProjects.Identity)' has invalid E2EAppMode '%(_E2EAppProjects.E2EAppMode)'. Valid values are build, publish, and all."
      Condition="'@(_E2EAppProjects)' != '' and '%(_E2EAppProjects.E2EAppMode)' != 'build' and '%(_E2EAppProjects.E2EAppMode)' != 'publish' and '%(_E2EAppProjects.E2EAppMode)' != 'all'" />
    <Error
      Text="E2EApp ProjectReference '%(_E2ENativeAotAppProjects.Identity)' has E2ENativeAot=true. Native AOT apps require E2EAppMode=publish."
      Condition="'@(_E2ENativeAotAppProjects)' != '' and '%(_E2ENativeAotAppProjects.E2EAppMode)' != 'publish'" />
    <Error
      Text="E2EApp ProjectReference '%(_E2ENativeAotAppProjects.Identity)' has E2ENativeAot=true but no E2ERuntimeIdentifier metadata. Specify exactly one RID for this invocation."
      Condition="'@(_E2ENativeAotAppProjects)' != '' and '%(_E2ENativeAotAppProjects.E2ERuntimeIdentifier)' == ''" />

    <!--
      Copy project source for build/all modes.
      During Publish, source is copied into the output so 'dotnet run' works after deployment.
      During Build (local dev), source is NOT copied — the manifest uses absolute paths.
    -->
    <ItemGroup Condition="'$(_E2EIsPublishing)' == 'true' and '@(_E2ESourceAppProjects)' != ''">
      <_E2ESourceFilesToCopy
        Include="%(_E2ESourceAppProjects.RootDir)%(_E2ESourceAppProjects.Directory)**\*"
        Exclude="%(_E2ESourceAppProjects.RootDir)%(_E2ESourceAppProjects.Directory)bin\**;%(_E2ESourceAppProjects.RootDir)%(_E2ESourceAppProjects.Directory)obj\**"
        E2EAppName="%(_E2ESourceAppProjects.Filename)"
        SourceRoot="%(_E2ESourceAppProjects.RootDir)%(_E2ESourceAppProjects.Directory)" />
    </ItemGroup>
    <Copy
      Condition="'@(_E2ESourceFilesToCopy)' != ''"
      SourceFiles="@(_E2ESourceFilesToCopy)"
      DestinationFiles="@(_E2ESourceFilesToCopy->'$(_E2EAppsOutputDir)\%(E2EAppName)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <!--
      Publish each E2E app project for publish/all modes.
      publish mode: output goes to e2e-apps/<name>/
      all mode:     output goes to e2e-apps/publish/<name>/
    -->
    <MSBuild
      Condition="'@(_E2EManagedPrimaryAppProjects)' != ''"
      Projects="@(_E2EManagedPrimaryAppProjects)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);%(_E2EManagedPrimaryAppProjects.SetConfiguration);%(_E2EManagedPrimaryAppProjects.SetPlatform);%(_E2EManagedPrimaryAppProjects.SetTargetFramework)" />
    <MSBuild
      Condition="'@(_E2ENativeAotAppProjects)' != ''"
      Projects="@(_E2ENativeAotAppProjects)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);%(_E2ENativeAotAppProjects.SetConfiguration);%(_E2ENativeAotAppProjects.SetPlatform);%(_E2ENativeAotAppProjects.SetTargetFramework)"
      RemoveProperties="NoBuild;BuildProjectReferences" />
    <MSBuild
      Condition="'@(_E2EPublishSecondaryAppProjects)' != ''"
      Projects="@(_E2EPublishSecondaryAppProjects)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);%(_E2EPublishSecondaryAppProjects.SetConfiguration);%(_E2EPublishSecondaryAppProjects.SetPlatform);%(_E2EPublishSecondaryAppProjects.SetTargetFramework)" />

    <!-- Warn loudly if E2E app projects are declared but the task assembly is missing -->
    <Warning
      Text="E2E app project(s) found (@(_E2EAppProjects)) but the GenerateE2EManifest task assembly could not be located. The e2e-manifest.json will NOT be generated. Ensure the Microsoft.AspNetCore.Components.Testing package is correctly installed."
      Condition="'@(_E2EAppProjects)' != '' and '$(_E2ETasksAssembly)' == ''" />

    <!-- Generate manifest -->
    <GenerateE2EManifest
      AppItems="@(_E2EAppProjects)"
      ManifestPath="$(_ManifestPath)"
      E2EAppsOutputDir="$(_E2EAppsOutputDir)"
      E2EAppsRelativeDir="$(E2EAppsRelativeDir)"
      E2EAppMode="$(E2EAppMode)"
      IsPublishing="$(_E2EIsPublishing)"
      Condition="'@(_E2EAppProjects)' != '' and '$(_E2ETasksAssembly)' != ''" />

  </Target>

  <Target Name="_PreparePublishedE2EApps"
          AfterTargets="Publish">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="PrepareE2EApps"
             Properties="_E2EIsPublishing=true;PublishDir=$(PublishDir)" />
  </Target>

</Project>
