@inject Microsoft.AspNetCore.Components.Platform.IBrowserPlatform Browser

<h2>URL</h2>

<button id="create-url" @onclick="CreateUrlAsync">Create URL</button>
<button id="use-disposed-url" @onclick="UseDisposedUrlAsync">Use disposed URL</button>
<p id="url-result" role="status">@result</p>

@code {
    private string result = "No operation has run.";

    private async Task CreateUrlAsync()
    {
        await using var url = await Browser.Url.CreateAsync(
            "../products",
            "https://example.test/store/");

        await url.SetHashAsync("featured");

        var searchParams = await url.GetSearchParamsAsync();
        await searchParams.SetAsync("page", "2");
        await searchParams.AppendAsync("tag", "one");

        result = await url.ToStringAsync();
    }

    private async Task UseDisposedUrlAsync()
    {
        var url = await Browser.Url.CreateAsync("https://example.test/");
        await url.DisposeAsync();

        try
        {
            await url.GetHrefAsync();
        }
        catch (ObjectDisposedException)
        {
            result = "Disposed URL rejected.";
        }
    }
}
