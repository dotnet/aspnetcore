@using System.Globalization
@implements IAsyncDisposable
@inject Microsoft.AspNetCore.Components.Platform.IBrowserPlatform Browser

<h2>Navigator</h2>

<div>
    <button id="get-language" @onclick="GetLanguageAsync">Language</button>
    <button id="get-languages" @onclick="GetLanguagesAsync">Languages</button>
    <button id="get-online" @onclick="GetOnLineAsync">Online</button>
    <button id="get-cookie-enabled" @onclick="GetCookieEnabledAsync">Cookie enabled</button>
    <button id="get-user-agent" @onclick="GetUserAgentAsync">User agent</button>
    <button id="get-hardware-concurrency" @onclick="GetHardwareConcurrencyAsync">Hardware concurrency</button>
    <button id="get-max-touch-points" @onclick="GetMaxTouchPointsAsync">Max touch points</button>
</div>
<div>
    <button id="watch-online-state" @onclick="WatchOnlineStateAsync">Watch online and offline</button>
    <button id="unwatch-online-state" @onclick="UnwatchOnlineStateAsync">Stop watching online and offline</button>
</div>
<p id="navigator-result" role="status" data-run="@runCount">@result</p>
<p id="online-state-event" role="status">@onlineStateEvent</p>

@code {
    private string result = "No operation has run.";
    private int runCount;
    private string onlineStateEvent = "No event has been reported.";
    private int onlineStateEventCount;
    private Task<IAsyncDisposable>? onlineListenerTask;
    private Task<IAsyncDisposable>? offlineListenerTask;

    private Task GetLanguageAsync() => RunAsync("Language", async () =>
        await Browser.Window.Navigator.GetLanguageAsync());

    private Task GetLanguagesAsync() => RunAsync("Languages", async () =>
        string.Join(", ", await Browser.Window.Navigator.GetLanguagesAsync()));

    private Task GetOnLineAsync() => RunAsync("Online", async () =>
        (await Browser.Window.Navigator.GetOnLineAsync()).ToString());

    private Task GetCookieEnabledAsync() => RunAsync("Cookie enabled", async () =>
        (await Browser.Window.Navigator.GetCookieEnabledAsync()).ToString());

    private Task GetUserAgentAsync() => RunAsync("User agent", async () =>
        await Browser.Window.Navigator.GetUserAgentAsync());

    private Task GetHardwareConcurrencyAsync() => RunAsync("Hardware concurrency", async () =>
        (await Browser.Window.Navigator.GetHardwareConcurrencyAsync()).ToString(CultureInfo.InvariantCulture));

    private Task GetMaxTouchPointsAsync() => RunAsync("Max touch points", async () =>
        (await Browser.Window.Navigator.GetMaxTouchPointsAsync()).ToString(CultureInfo.InvariantCulture));

    private Task WatchOnlineStateAsync() => RunAsync("Watch online and offline", async () =>
    {
        // Stored before the first await, so a click while adding reuses the pending pair instead of adding another.
        var online = onlineListenerTask ??= Browser.Window.AddEventListenerAsync(Window.OnlineEvent, _ => ReportOnlineStateEvent("online")).AsTask();
        var offline = offlineListenerTask ??= Browser.Window.AddEventListenerAsync(Window.OfflineEvent, _ => ReportOnlineStateEvent("offline")).AsTask();
        await online;
        await offline;
        return "added";
    });

    private Task UnwatchOnlineStateAsync() => RunAsync("Stop watching online and offline", async () =>
    {
        await DisposeListenersAsync();
        return "removed";
    });

    // The count tells two events of the same name apart. The listener runs on the renderer's dispatcher.
    private Task ReportOnlineStateEvent(string name)
    {
        onlineStateEventCount++;
        onlineStateEvent = $"{name} ({onlineStateEventCount.ToString(CultureInfo.InvariantCulture)})";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task DisposeListenersAsync()
    {
        // Cleared before the first await, so a Watch click meanwhile adds a new pair that this call does not remove.
        var online = onlineListenerTask;
        var offline = offlineListenerTask;
        onlineListenerTask = null;
        offlineListenerTask = null;

        if (online is not null)
        {
            await (await online).DisposeAsync();
        }

        if (offline is not null)
        {
            await (await offline).DisposeAsync();
        }
    }

    private async Task RunAsync(string operation, Func<Task<string>> run)
    {
        result = $"{operation}: {await run()}";
        // Counts only completed runs, so a test waits for its own click and an exception fails at its step.
        runCount++;
    }

    public async ValueTask DisposeAsync() => await DisposeListenersAsync();
}
