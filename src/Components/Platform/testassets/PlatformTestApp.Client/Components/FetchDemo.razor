@inject Microsoft.AspNetCore.Components.Platform.IBrowserPlatform Browser

<h2>Fetch</h2>

<button id="fetch-echo" @onclick="FetchEchoAsync">Fetch echo</button>
<button id="fetch-missing" @onclick="FetchMissingAsync">Fetch missing</button>
<p id="fetch-result" role="status">@result</p>

@code {
    private string result = "No operation has run.";

    private async Task FetchEchoAsync()
    {
        await using var response = await Browser.FetchAsync(
            "/platform-api/echo",
            new Microsoft.AspNetCore.Components.Platform.RequestInit
            {
                Method = "POST",
                Headers = new Dictionary<string, string>
                {
                    ["content-type"] = "text/plain",
                },
                Body = "request-body",
            });

        var headers = await response.GetHeadersAsync();
        var source = await headers.GetAsync("x-components-platform");
        var status = await response.GetStatusAsync();
        var body = await response.TextAsync();

        result = $"{status}:{source}:{body}";
    }

    private async Task FetchMissingAsync()
    {
        await using var response = await Browser.FetchAsync("/platform-api/missing");
        var status = await response.GetStatusAsync();
        var ok = await response.GetOkAsync();

        result = $"{status}:{ok}";
    }
}
