@inject Microsoft.AspNetCore.Components.Platform.IBrowserPlatform Browser

<h2>Web Storage</h2>

<label for="storage-value">Value</label>
<input id="storage-value" @bind="value" />
<button id="save-storage" @onclick="SaveAsync">Save</button>
<button id="load-storage" @onclick="LoadAsync">Load</button>
<button id="remove-storage" @onclick="RemoveAsync">Remove</button>
<p id="storage-result" role="status">@result</p>

@code {
    private const string StorageKey = "components-platform-e2e";
    private string value = "initial";
    private string result = "No operation has run.";

    private async Task SaveAsync()
    {
        await Browser.Window.LocalStorage.SetItemAsync(StorageKey, value);
        result = $"Saved: {value}";
    }

    private async Task LoadAsync()
    {
        value = await Browser.Window.LocalStorage.GetItemAsync(StorageKey) ?? string.Empty;
        result = value.Length == 0 ? "Value is missing." : $"Loaded: {value}";
    }

    private async Task RemoveAsync()
    {
        await Browser.Window.LocalStorage.RemoveItemAsync(StorageKey);
        value = string.Empty;
        result = "Value removed.";
    }
}
