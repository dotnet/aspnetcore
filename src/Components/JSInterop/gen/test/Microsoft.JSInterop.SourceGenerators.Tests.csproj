<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultNetCoreTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- GeneratedJSInterop is experimental. -->
    <NoWarn>$(NoWarn);ASP0041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

    <ProjectReference Include="$(RepoRoot)src\Components\JSInterop\src\Microsoft.JSInterop.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Components\JSInterop\gen\Microsoft.JSInterop.SourceGenerators.csproj" />
  </ItemGroup>

</Project>
