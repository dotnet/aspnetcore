<Project>
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true' or (('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(UsingMicrosoftNETSdkWeb)' == 'true')">
    <StaticWebAssetGroup Include="BlazorWebAssembly"
      Value="enabled"
      SourceId="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>
</Project>
