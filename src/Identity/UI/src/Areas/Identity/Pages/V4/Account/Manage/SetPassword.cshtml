@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Set password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>Set your password</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<p class="text-info">
    You do not have a local username/password for this site. Add a local
    account so you can log in without an external login.
</p>
<div class="row">
    <div class="col-md-6">
        @if (!Model.IsReauthenticated)
        {
            <h4>Confirm it's you</h4>
            <p class="text-info">Setting a password creates a new way to sign in to your account.</p>
            @if (Model.CurrentLogins is null)
            {
                <p class="text-danger">Setting a password requires a user store that supports security stamps.</p>
            }
            else if (Model.CurrentLogins.Count == 0)
            {
                <p class="text-info">You must have a configured external login linked to this account to confirm your identity before setting a password.</p>
            }
            else
            {
                <form id="reauthenticate-form" asp-page-handler="Reauthenticate" method="post">
                    <div class="form-group">
                        @foreach (var login in Model.CurrentLogins)
                        {
                            <button type="submit" class="btn btn-primary" name="provider" value="@login.LoginProvider" title="Confirm using your @login.ProviderDisplayName account">
                                Confirm with @login.ProviderDisplayName
                            </button>
                        }
                    </div>
                </form>
            }
        }

        @* Keep the form after confirmation expires so a stale post gets a message. Forms must be siblings, not nested. *@
        <form id="set-password-form" asp-page-handler="" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (Model.IsReauthenticated)
            {
                <div class="form-group">
                    <label asp-for="Input.NewPassword"></label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Set password</button>
            }
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
