<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>DirectTls (fd-bound, native OpenSSL) transport for the ASP.NET Core Kestrel cross-platform web server. Linux only.</Description>
    <TargetFramework>$(DefaultNetCoreTargetFramework)</TargetFramework>
    <IsAspNetCoreApp>true</IsAspNetCoreApp>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>aspnetcore;kestrel</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <!-- DirectTls consumes the experimental low-level TLS API (TlsContext/TlsSocketSession).
         ASPNETCORE_DIRECTTLS_001 is this transport's own [Experimental] id; suppress it inside the
         defining assembly so the factory/extensions can use the endpoint API without warnings.
         CS0436: this project has InternalsVisibleTo from Kestrel.Core (to read ListenOptions.Protocols
         at bind time) and also share-source-compiles the same ServerInfrastructure files Core does
         (DuplexPipe, TransportConnection); the identical local copies win and are only used internally. -->
    <NoWarn>$(NoWarn);SYSLIB5007;ASPNETCORE_DIRECTTLS_001;CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(KestrelSharedSourceRoot)\CorrelationIdGenerator.cs" Link="Internal\CorrelationIdGenerator.cs" />
    <Compile Include="$(SharedSourceRoot)ServerInfrastructure\DuplexPipe.cs" Link="Internal\DuplexPipe.cs" />
    <Compile Include="$(KestrelSharedSourceRoot)\TransportConnection.cs" Link="Internal\TransportConnection.cs" />
    <Compile Include="$(KestrelSharedSourceRoot)\TransportConnection.Generated.cs" Link="Internal\TransportConnection.Generated.cs" />
    <Compile Include="$(KestrelSharedSourceRoot)\TransportConnection.FeatureCollection.cs" Link="Internal\TransportConnection.FeatureCollection.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.AspNetCore.Hosting.Abstractions" />
    <Reference Include="Microsoft.AspNetCore.Connections.Abstractions" />
    <Reference Include="Microsoft.AspNetCore.Http.Features" />
    <Reference Include="Microsoft.AspNetCore.Server.Kestrel.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.AspNetCore.Server.Kestrel.Transport.DirectTls.Tests" />
    <InternalsVisibleTo Include="Sockets.FunctionalTests" />
  </ItemGroup>
</Project>
