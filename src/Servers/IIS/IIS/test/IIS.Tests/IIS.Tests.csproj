    <ProjectReference Include="$(RepoRoot)src\Servers\Kestrel\Transport.Quic\src\Microsoft.AspNetCore.Server.Kestrel.Transport.Quic.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Servers\Kestrel\Transport.Sockets\src\Microsoft.AspNetCore.Server.Kestrel.Transport.Sockets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AppHostConfig\HostableWebCore.config" CopyToOutputDirectory="PreserveNewest" Link="%(FileName)%(Extension)" />
    <None Include="$(AspNetCoreModuleV2ShimDll)" Condition="'$(PackNativeAssets)' == 'true'" CopyToOutputDirectory="PreserveNewest" Link="%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
